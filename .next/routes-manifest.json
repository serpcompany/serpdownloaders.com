    {
      "page": "/rss.xml",
      "regex": "^/rss\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rss\\.xml(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
