        "popup.html",
        "popup.js"
      ],
      "purpose": "UI, quality selector, live capture start/stop, auth flow"
    },
    {
      "component": "Offscreen",
      "files": [
        "offscreen.html",
        "offscreen.js"
      ],
      "purpose": "MP4 streaming + HLS transmux + live capture recording"
    },
    {
      "component": "Auth",
      "files": [
        "auth.js",
        "auth-ui.js",
        "auth/"
      ],
      "purpose": "OTP login, entitlements, trial"
    },
    {
      "component": "Download Manager",
      "files": [
        "download-manager.js"
      ],
      "purpose": "In-page download progress panel with live capture support"
    },
    {
      "component": "Logger",
      "files": [
        "logger.js"
      ],
      "purpose": "Structured logging, bg mirroring"
    },
    {
      "component": "Site Config",
      "files": [
        "site-config.js"
      ],
      "purpose": "Brand colors, endpoints, flags"
    },
    {
      "component": "Update Notifier",
      "files": [
        "update-notifier.js"
      ],
      "purpose": "GitHub release checks"
    },
    {
      "component": "Trial Banner",
      "files": [
        "trial-banner.js"
      ],
      "purpose": "Trial remaining badge"
    },
    {
      "component": "Inject",
      "files": [
        "inject.js"
      ],
      "purpose": "Page-context Fansly API monitor, HLS URL discovery"
    },
    {
      "component": "Popup UI Overrides",
      "files": [
        "popup-ui-overrides.js"
      ],
      "purpose": "Popup customizations"
    }
  ],
