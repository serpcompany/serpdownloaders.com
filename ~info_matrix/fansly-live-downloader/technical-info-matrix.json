{
  "extension": "fansly-live-downloader",
  "coreIdentity": {
    "extensionName": "SERP FanslyLive Downloader",
    "slug": "fansly-live-downloader",
    "geckoId": "fansly-live-downloader@serpapps.com",
    "category": "Live Stream Downloader (Adult)",
    "targetSites": [
      "fansly.com"
    ],
    "targetSiteMatches": [
      "https://fansly.com/*",
      "https://www.fansly.com/*",
      "https://*.fansly.com/*"
    ],
    "description": "Download FanslyLive live streams and recordings"
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/fansly-live-downloader",
    "lastUpdated": "2026-03-06",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "fansly-live-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/fansly-live-video-downloader",
    "productPage": "https://serp.ly/fansly-live-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "HLS Live Capture (real-time segment recording to MP4 transmux)",
      "HLS VOD Stitching (m3u8 segment to MP4 transmux)",
      "Direct MP4 (offscreen streaming)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from HLS master playlists (variant bandwidth/resolution), Fansly API stream metadata, inject.js page data",
    "qualitySorting": "By resolution descending, bandwidth-based labels",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": true,
    "liveCaptureMode": "Real-time HLS segment capture with start/stop, segment counting, elapsed timer",
    "vrSupport": true,
    "vrFeatures": "VR camera settings detection (stereo packing, frame format, horizontal angle), VR filename suffix, VR badge in popup",
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "[data-testid=\"video-player\"]",
      ".player__video-wrapper",
      ".video-player__wrapper",
      ".media-player",
      "#player-root",
      ".video-player",
      "nearest video container"
    ],
    "contextMenu": true,
    "contextMenuId": "download-fansly-live-video",
    "contextMenuTitle": "Download FanslyLive Stream",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "FANSLYLIVE/",
    "desktopNotifications": false,
    "videoDetection": "Multi-source: Fansly API (apiv3.fansly.com), inject.js page-context monitor, HLS master playlist probing across CDN hosts"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://*/*",
      "https://fansly.com/*",
      "https://www.fansly.com/*",
      "https://apiv3.fansly.com/*",
      "https://*.fansly.com/*"
    ],
    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://fansly.com/*",
        "https://www.fansly.com/*",
        "https://*.fansly.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "MP4 streaming download + HLS segment transmuxing + live capture recording"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs",
    "reencoder": "modules/reencoder/",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "Page-context Fansly API monitor, HLS URL discovery, model/stream data extraction",
      "messageType": "FANSLY_LIVE_PAGE_DATA",
      "requestType": "REQUEST_FANSLY_LIVE_DATA"
    },
    "externalAPIs": [
      "Fansly API (apiv3.fansly.com)",
      "Fansly Front API (fansly.com/api/front/v2)",
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "fansly-live-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/fansly-live-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/fansly-live-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "pageTypeDetection": "live (default) or vod (URL matches /videos?/ pattern)",
    "modelIdSources": [
      "Fansly API account lookup (apiv3.fansly.com/api/v1/account)",
      "URL path segments (/live/{username})",
      "inject.js page data"
    ],
    "titleSources": [
      "displayName",
      "modelName",
      "modelUsername",
      "document.title"
    ],
    "thumbnailSources": [
      "meta[property=\"og:image\"]"
    ],
    "streamDiscoverySources": [
      "Fansly API streaming channel endpoint (apiv3.fansly.com/api/v1/streaming/channel/{id})",
      "__PRELOADED_STATE__",
      "__INITIAL_STATE__",
      "__NUXT__",
      "__NEXT_DATA__",
      "__APOLLO_STATE__",
      "__STATE__",
      "Performance API resource entries",
      "Script regex for m3u8 URLs"
    ],
    "cdnHosts": [
      "doppiocdn.com",
      "doppiocdn.net",
      "stripcdnm.com",
      "stripcdnmd.com",
      "stripcdntmp.com",
      "sc-cdn.net"
    ],
    "hlsMasterUrlPattern": "https://edge-hls.{host}/hls/{streamId}/master/{streamId}_auto.m3u8",
    "mediaRequestPatterns": [
      ".m3u8",
      "apiv3.fansly.com",
      "fansly.com/api/front/v2"
    ],
    "injectMessageType": "FANSLY_LIVE_PAGE_DATA",
    "injectRequestType": "REQUEST_FANSLY_LIVE_DATA",
    "vodDetection": {
      "urlPattern": "/{username}/videos/{videoId}",
      "apiEndpoint": "fansly.com/api/front/v2/users/{userId}/videos"
    }
  },
  "formatObjectStructure": {
    "quality": "string (e.g. '1080p (HLS)', 'Auto (HLS)', 'Trailer (MP4)', 'Source (MP4)')",
    "url": "string",
    "type": "hls | mp4",
    "format": "string (e.g. 'HLS', 'MP4')",
    "height": "number | null",
    "bandwidth": "number | null",
    "fps": "number | null",
    "requestUrl": "string | null",
    "extraParams": "object | null"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "livePollIntervalMs": 1400,
    "liveIdleLimitWithData": 35,
    "liveIdleLimitNoData": 12,
    "liveMaxPlaylistErrors": 8,
    "liveFirstBatchLimit": 8,
    "liveTickTailLimit": 4,
    "referer": "https://fansly.com/",
    "origin": "https://fansly.com"
  },
  "architecture": [
    {
      "component": "Content Script",
      "files": [
        "content.js"
      ],
      "purpose": "Video/stream detection, Fansly API data extraction, download progress forwarding"
