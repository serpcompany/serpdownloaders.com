  "multiPlatformDetection": {
    "platforms": [
      {
        "platform": "Skool",
        "detector": [
          "skool-detector.js",
          "skool-detector-working.js"
        ],
        "detectionMethods": [
          "Next.js __NEXT_DATA__ page props",
          "Mux player elements",
          "<video> with blob sources",
          "Course structure data",
          "videoStream/videoLink fields"
        ],
        "handler": "SkoolHandler"
      },
      {
        "platform": "Loom",
        "detector": [
          "loom-detector.js"
        ],
        "detectionMethods": [
          "Iframes (loom.com/embed, loom.com/share)",
          "Video elements with data-loom-video-id",
          "Loom classes/IDs",
          "Direct links",
          "Script tags"
        ],
        "handler": "LoomHandler"
      },
      {
        "platform": "Vimeo",
        "detector": [
          "vimeo-detector.js"
        ],
        "detectionMethods": [
          "window.playerConfig",
          "Iframe embeds",
          "Data attributes",
          "Direct Vimeo page visits",
          "Embed info extraction"
        ],
        "handler": "VimeoHandler"
      },
      {
        "platform": "YouTube",
        "detector": [
          "youtube-detector.js"
        ],
        "detectionMethods": [
          "Iframe embeds",
          "/watch?v=",
          "/embed/",
          "/shorts/",
          "youtu.be/",
          "nocookie embeds",
          "Script content"
        ],
        "handler": "YouTubeHandler"
      },
      {
        "platform": "Wistia",
        "detector": [
          "wistia-detector.js"
        ],
        "detectionMethods": [
          "Direct Wistia URLs (medias/, embed/)",
          "Iframe embeds",
          "Source elements",
          "Data attributes",
          "Wistia-specific elements"
        ],
        "handler": "WistiaHandler"
      }
    ]
  },
  "skoolSpecificDetection": {
    "siteMatch": [
      "https://www.skool.com/*",
      "https://*.skool.com/*"
    ],
    "pageProps": "Parses __NEXT_DATA__ (Next.js SSR data) from window object, <script id=\"__NEXT_DATA__\"> tag, and any script containing videoStream/videoLink patterns",
    "muxPlayer": "Detects <mux-player> elements with playback IDs",
    "wistiaDeferral": "Auto-defers to Wistia detector when .wistia_embed, [class*=\"wistia_async_\"], or Wistia iframes/sources are detected on Skool pages",
    "loomPriority": "Checks for video[id*=\"Loom\"], video[data-loom-video-id] elements first (highest priority)",
    "nativeVideo": "Detects <video> elements with blob: sources on Skool domain",
    "courseData": "Extracts course structure and module data from page props"
  },
  "formatObjectStructure": {
    "platform": "Skool | Loom | Vimeo | YouTube | Wistia",
    "id": "string",
    "title": "string",
    "url": "string",
    "thumbnail": "string | null",
    "duration": "number | null",
    "formats": {
      "quality": "number | string",
      "url": "string",
      "ext": "mp4 | m3u8",
      "format_type": "hls | mp4 | progressive",
      "height": "number | null",
      "width": "number | null"
