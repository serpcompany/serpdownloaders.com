    "contextMenu": false,
    "autoSave": true,
    "downloadFolder": "Twitter X Downloader/{source}/{title}.{ext}",
    "desktopNotifications": false,
    "videoDetection": "Multi-source: DOM video elements, inline script data (twimg URLs), Performance API resource entries, feed permalink scanning, X API (status + syndication)",
    "imageDetection": "DOM img elements filtered by twimg.com host, minimum 180x180px, sorted by area",
    "textExtraction": "Post text from tweet/article roots with See more auto-expansion",
    "assetTypes": [
      "Videos",
      "Images",
      "Text Posts"
    ]
