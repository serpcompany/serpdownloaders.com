  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (chrome.downloads API)",
      "Blob fallback (authenticated fetch)",
      "X API resolution (status + syndication)",
      "Page-side download delegation"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from URL resolution patterns (e.g. 720p, 1080p), scored by bitrate and format",
    "qualitySorting": "By score descending (MP4 preferred over HLS, higher bitrate preferred)",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": true,
    "bulkDownloadMode": "Download Visible button downloads all items in the active tab (videos, images, or texts)",
    "inPagePlayerButton": true,
