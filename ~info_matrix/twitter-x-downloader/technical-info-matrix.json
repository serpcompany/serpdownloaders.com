    "pageInjection": null,
    "declarativeNetRequest": {
      "enabled": true,
      "ruleIds": [42001, 42002, 42003],
      "rules": [
        {
          "id": 42001,
          "condition": "Request domains: twimg.com, x.com, twitter.com, t.co",
          "action": "Set Origin: https://x.com, Referer: https://x.com/"
        },
        {
          "id": 42002,
          "condition": "URL filter: ||scontent.",
          "action": "Set Origin: https://x.com, Referer: https://x.com/"
        },
        {
          "id": 42003,
          "condition": "Request domains: x.com, twitter.com (XHR/media)",
          "action": "Set Origin: https://x.com, Referer: https://x.com/"
        }
      ]
    },
    "externalAPIs": [
