    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/([^/]+)/videos/(\\d+)(?:/|$)"
    ],
    "titleSources": [
      "inject.js displayName/modelName/modelUsername",
      "document.title",
      "meta[property=\"og:title\"]"
    ],
    "thumbnailSources": [
      "og:image",
      "inject.js avatar/thumbnail"
    ],
    "durationSources": [
      "VOD API entry duration"
    ],
    "extraMetadata": {
      "viewerCount": "inject.js viewerCount",
      "isLive": "inject.js isLive / API status",
      "isPrivate": "inject.js isPrivate",
      "modelId": "share.myfreecams.com data-cam-preview-model-id-value",
      "serverId": "share.myfreecams.com data-cam-preview-server-id-value"
    },
    "formatSources": [
      "HLS master manifest (edge-hls CDN)",
      "share.myfreecams.com preview card attributes",
      "MyFreeCams stream API (/api/front/v2/models/username/*/cam)",
      "VOD videos API (/api/front/v2/users/*/videos)"
    ],
    "scriptUrlRegex": "/https?:\\/\\/[^\"'\\s<>]+\\.m3u8[^\"'\\s<>]*/ig",
    "cdnDetectionPattern": "doppiocdn.com, doppiocdn.net, stripcdnm.com, stripcdnmd.com, stripcdntmp.com, sc-cdn.net, previews.myfreecams.com",
    "mediaRequestPatterns": [
      ".m3u8",
      "edge-hls.",
      "doppiocdn",
      "previews.myfreecams.com",
      "/hls/",
      "/master/"
    ],
    "injectMessageType": "MYFREECAMS_PAGE_DATA"
  },
  "formatObjectStructure": {
    "format_id": "string",
    "ext": "m3u8 | mp4",
    "format_type": "hls | mp4",
    "quality": "string (e.g. '1080p (HLS)', 'Auto (HLS)', 'Trailer (MP4)')",
    "url": "string",
    "requestUrl": "string (with extra query params)",
    "masterUrl": "string",
    "height": "number | null",
    "bandwidth": "number | null",
    "fps": "number | null",
    "type": "hls | mp4",
    "extraParams": "object | null"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
