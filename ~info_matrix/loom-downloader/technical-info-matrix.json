    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "loom-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/loom-video-downloader",
    "productPage": "https://serp.ly/loom-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (offscreen streaming)",
      "HLS Stitching (m3u8 segment-to-MP4 transmux)",
      "DASH Stitching (MPD segment merge)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from HLS master manifest variant resolution and DASH adaptation set representations",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": "Free trial downloads after sign-in (server-managed via auth.serp.co)",
    "hasDownloadManager": true,
    "downloadManagerType": "In-page inline manager with cross-tab sync",
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPageOverlayButton": true,
    "overlayButtonTargets": [
      ".video-container",
      "[data-testid='video-container']",
      ".loom-video-container",
      ".loom-player-container",
      ".loomVideoPlayer",
      "[data-loom-player]",
      "iframe[src*='loom.com/embed/'] parent containers"
    ],
    "libraryCardButton": true,
    "libraryCardButtonClass": "loom-download-card-button",
    "contextMenu": false,
    "autoSave": false,
    "saveAsDialog": true,
    "desktopNotifications": false,
    "videoDetection": "Automatic: Loom share URLs, embed iframes, data-loom-video-id attributes, Loom links, script tag references",
    "passwordProtectedVideos": true,
    "embedDetection": true,
    "embedDetectionScope": "<all_urls>",
    "multipleVideoSelection": true
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "scripting",
      "offscreen",
      "webNavigation"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://www.loom.com/*",
      "https://*.loom.com/*",
      "https://*.loomcdn.com/*",
      "https://*.cloudfront.net/*",
      "https://api.gumroad.com/*"
    ],
    "contentScripts": [
      {
        "files": [
          "site-config.js",
          "logger.js",
          "download-manager/inline-manager.js"
        ],
        "matches": [
          "<all_urls>"
        ],
        "allFrames": false,
        "runAt": "document_idle"
      },
      {
        "files": [
          "site-config.js",
          "logger.js",
          "content-enhanced.js"
        ],
        "matches": [
          "<all_urls>"
        ],
        "runAt": "document_idle"
      }
    ],
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "HLS segment transmuxing + DASH segment merging"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (318 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true,
      "file": "indexed-db.js",
      "purpose": "Segment caching"
    },
    "pageInjection": null,
    "externalAPIs": [
      "Loom GraphQL API (www.loom.com/graphql)",
      "Loom URL APIs (www.loom.com/api/campaigns/sessions/{id}/raw-url, transcoded-url)",
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "Gumroad API (api.gumroad.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "loom-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/loom-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/loom-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": [],
    "webAccessibleResources": [
      "offscreen.html",
      "offscreen.js",
      "indexed-db.js",
      "modules/**/*",
      "download-manager/**/*",
      "download-manager/integration-helper.js",
      "download-manager/download-manager.js",
      "download-manager/download-manager-ui.js",
      "download-manager/download-manager-state.js",
      "download-manager/download-manager-config.js"
    ]
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "loom.com/share/([a-f0-9]{32})",
      "loom.com/embed/([a-f0-9]{32})",
      "video[data-loom-video-id] (32-char hex attribute)"
    ],
    "titleSources": [
      "document.title (with ' - Loom' suffix stripped)",
      "iframe.title",
      "iframe[aria-label]",
      "video[title]",
      "video[aria-label]",
      "link.textContent",
      "GraphQL metadata.name"
    ],
    "metadataSources": {
      "owner": "GraphQL owner.display_name",
      "width": "GraphQL video_properties.width",
      "height": "GraphQL video_properties.height",
      "duration": "GraphQL video_properties.duration (updated after manifest parse)",
      "description": "GraphQL description",
      "isProtected": "GraphQL is_protected",
      "needsPassword": "GraphQL needs_password",
      "downloadEnabled": "GraphQL download_enabled",
      "privacy": "GraphQL privacy",
      "createdAt": "GraphQL createdAt"
    },
    "embedDetectionSources": [
      "iframe[src*='loom.com/embed/'] (highest priority)",
      "video[data-loom-video-id]",
      "video[id*='Loom'] / video[class*='loom'] / video[class*='Loom']",
      "a[href*='loom.com/share/'] links",
      "script tag content matching loom.com/(embed|share)/([a-f0-9]{32})"
    ],
    "downloadUrlSources": [
      "Loom URL API raw-url endpoint (primary)",
      "Loom URL API transcoded-url endpoint (fallback)"
    ]
  },
  "loomApiIntegration": {
    "graphqlApi": {
      "endpoint": "POST https://www.loom.com/graphql",
      "query": "GetVideoSSR",
      "purpose": "Video metadata extraction — title, owner, dimensions, duration, password check",
      "headers": {
        "x-loom-request-source": "loom_web_{APOLLO_GRAPHQL_VERSION}",
        "apollographql-client-name": "web",
        "apollographql-client-version": "743c46d",
        "Referer": "https://www.loom.com/",
        "Origin": "https://www.loom.com",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
      }
    },
    "rawUrlApi": {
      "endpoint": "POST https://www.loom.com/api/campaigns/sessions/{videoId}/raw-url",
      "purpose": "Retrieves raw download URL (HLS/DASH/MP4)"
    },
    "transcodedUrlApi": {
      "endpoint": "POST https://www.loom.com/api/campaigns/sessions/{videoId}/transcoded-url",
      "purpose": "Retrieves transcoded download URL (fallback)"
    }
  },
  "hlsProcessingSpecs": {
    "manifestHandling": "Master M3U8 parsed for variant streams, audio/video playlists resolved separately",
    "splitUrlFix": "-split.m3u8 URLs automatically converted to .m3u8",
    "segmentDownload": "Memory-optimized with incremental processing and IndexedDB caching",
    "separateAV": true
  },
  "dashProcessingSpecs": {
    "manifestParsing": "Regex-based XML parser for MPD manifests",
    "representationSelection": "Highest bandwidth video representation, first audio representation",
    "segmentExtraction": "SegmentTemplate with SegmentTimeline support ($Number$ substitution)",
    "segmentDownload": "Memory-optimized with incremental processing",
    "mergeMethod": "Offscreen document MERGE_DASH_SEGMENTS processing"
  },
  "downloadQueueSystem": {
    "maxConcurrentDownloads": 3,
    "queueSystem": "DownloadTaskRegistry with centralized queue/registry",
    "cancellation": "Per-download cancellation via AbortController, cancel-all support",
    "statePersistence": "chrome.storage.local with downloadManagerGlobalState key",
    "staleEntryCleanup": true,
    "completeLingerMs": 2500
  },
  "overlayButtonConfig": {
    "containerTargets": [
      ".video-container",
      "[data-testid='video-container']",
