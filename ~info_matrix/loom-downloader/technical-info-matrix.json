{
  "extension": "loom-downloader",
  "coreIdentity": {
    "extensionName": "Video Downloader for Loom",
    "slug": "loom-downloader",
    "geckoId": "loom-downloader@serpapps.com",
    "category": "Video Downloader (Professional / Business)",
    "targetSites": [
      "loom.com",
      "loomcdn.com",
      "cloudfront.net"
    ],
    "targetSiteMatches": [
      "https://www.loom.com/*",
      "https://*.loom.com/*",
      "https://*.loomcdn.com/*",
      "https://*.cloudfront.net/*"
    ],
    "description": "Download Loom videos directly to your computer"
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/loom-downloader",
