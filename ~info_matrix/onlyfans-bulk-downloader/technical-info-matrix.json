  "bulkDownloadWorkflow": [
    {
      "step": 1,
      "page": "settings.html",
      "description": "Verify OnlyFans sign-in, load dynamic rules, configure rate limiter preset, save settings"
    },
    {
      "step": 2,
      "page": "selection.html",
      "description": "Fetch subscriptions from OnlyFans API (50 per page), display creators with avatars, multi-select, choose media type filter"
    },
    {
      "step": 3,
      "page": "list.html",
      "description": "Iterate selected creators, fetch posts via OnlyFans API, extract media URLs (images/videos), build download queue items"
    },
    {
      "step": 4,
      "page": "progress.html",
      "description": "Process download queue with rate limiting, show real-time progress, concurrency control (1-8), pause/resume/stop/cancel/retry"
    }
  ],
  "rateLimiterPresets": {
    "conservative": {
      "minDelay": 2000,
      "maxDelay": 3000,
      "maxRequestsPerMinute": 25,
      "enableJitter": true,
      "backoffMultiplier": 2,
      "maxBackoffDelay": 30000
    },
    "balanced": {
      "minDelay": 1000,
      "maxDelay": 1500,
      "maxRequestsPerMinute": 45,
      "enableJitter": true,
      "backoffMultiplier": 1.5,
      "maxBackoffDelay": 20000
    },
    "aggressive": {
      "minDelay": 500,
      "maxDelay": 1000,
      "maxRequestsPerMinute": 70,
      "enableJitter": true,
      "backoffMultiplier": 1.2,
      "maxBackoffDelay": 10000
    }
  },
