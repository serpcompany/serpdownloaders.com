{
  "extension": "dreamcam-downloader",
  "coreIdentity": {
    "extensionName": "SERP DreamCam Downloader",
    "slug": "dreamcam-downloader",
    "geckoId": "dreamcam-downloader@serpapps.com",
    "category": "Live Stream Downloader (Adult / Cam)",
    "targetSites": [
      "dreamcamtrue.com"
    ],
    "targetSiteMatches": [
      "https://dreamcamtrue.com/*",
      "https://www.dreamcamtrue.com/*",
      "https://*.dreamcamtrue.com/*"
    ],
    "description": "Download DreamCam live streams and recordings"
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/dreamcam-downloader",
    "lastUpdated": "2026-03-06",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "dreamcam-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/dreamcam-video-downloader",
    "productPage": "https://serp.ly/dreamcam-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "HLS Stitching (m3u8 segment to MP4 transmux)",
      "Direct MP4 (offscreen streaming)",
      "Live Capture (LL-HLS continuous recording with start/stop)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from HLS master manifest EXT-X-STREAM-INF variants (resolution, bandwidth, frame rate)",
    "qualitySorting": "By height * 10 + bandwidth descending",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": true,
    "liveStreamMethod": "LL-HLS continuous capture with start/stop, segment counting, elapsed timer",
    "vrSupport": true,
    "vrDetails": "VR camera settings detection (stereoPacking, frameFormat, horizontalAngle), VR filename suffix, VR badge in UI",
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "[data-testid=\"video-player\"]",
      ".player__video-wrapper",
      ".video-player__wrapper",
      ".media-player",
      "#player-root",
      ".video-player",
      "nearest video container"
    ],
    "contextMenu": true,
    "contextMenuId": "download-dreamcam-video",
    "contextMenuTitle": "Download DreamCam Stream",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "DREAMCAM/",
    "desktopNotifications": false,
    "notificationTitle": null,
    "videoDetection": "Multi-source: inject.js DreamCam API adapter, page state globals, Performance API, script regex, MutationObserver"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://*/*",
      "https://dreamcamtrue.com/*",
      "https://www.dreamcamtrue.com/*",
      "https://bss.dreamcamtrue.com/*",
      "https://*.dreamcamtrue.com/*"
    ],
    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://dreamcamtrue.com/*",
        "https://www.dreamcamtrue.com/*",
        "https://*.dreamcamtrue.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "HLS segment transmuxing + MP4 streaming + live capture recording"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "DreamCam API adapter, HLS URL collection, model data extraction via page-context globals and Performance API",
      "messageType": "DREAMCAM_PAGE_DATA",
      "requestType": "REQUEST_DREAMCAM_DATA"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "DreamCam Broadcast API (bss.dreamcamtrue.com/api/clients/v1/broadcasts/models/)",
      "DreamCam Frontend API (dreamcamtrue.com/api/front/v2/)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "dreamcam-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/dreamcam-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/dreamcam-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "streamIdSources": [
      "modelNumericId",
      "modelId",
      "id",
      "roomSlug",
      "streamName",
      "potentialNumericIds[]",
      "API streamName",
      "API userId"
    ],
    "titleSources": [
      "displayName",
      "modelName",
      "modelUsername",
      "document.title"
    ],
    "thumbnailSources": [
      "inject data thumbnail",
      "meta[property=\"og:image\"]"
    ],
    "durationSources": [
      "VOD API duration field"
    ],
    "extraMetadata": {
      "viewerCount": "inject data viewerCount",
      "isLive": "inject data isLive / API status",
      "isPrivate": "inject data isPrivate",
      "isVr": "inject data isVr / API vrCameraSettings",
      "vrCameraSettings": "stereoPacking, frameFormat, horizontalAngle",
      "broadcastSettings": "API broadcastSettings object",
      "statusMessage": "Computed from isPrivate/isLive state"
    },
    "formatSources": [
      "DreamCam broadcast API (bss.dreamcamtrue.com)",
      "DreamCam frontend API (/api/front/v2/)",
      "Inject.js page state globals (__PRELOADED_STATE__, __INITIAL_STATE__, etc.)",
      "Performance API resource entries",
      "Script regex for m3u8 URLs"
    ],
    "cdnHosts": [
      "doppiocdn.com",
      "doppiocdn.net",
      "stripcdnm.com",
      "stripcdnmd.com",
      "stripcdntmp.com",
      "sc-cdn.net"
    ],
    "masterUrlPattern": "https://edge-hls.{host}/hls/{streamId}/master/{streamId}_auto.m3u8",
    "bestOnlyUrlPattern": "https://edge-hls.{host}/hls/{streamId}/master/{streamId}.m3u8",
    "mouflonDecoding": true,
    "mouflonDetails": "EXT-X-MOUFLON:PSCH tag detection, HMAC-SHA256 URI rewriting, fallback key cache",
    "vodDetection": {
      "urlPattern": "/{roomSlug}/videos/{videoId}",
      "explicitPageType": "vod",
      "apiEndpoint": "/api/front/v2/users/{userId}/videos"
    },
    "injectMessageType": "DREAMCAM_PAGE_DATA",
    "injectRequestType": "REQUEST_DREAMCAM_DATA"
  },
  "formatObjectStructure": {
    "url": "string",
    "requestUrl": "string (with query params)",
    "masterUrl": "string",
    "quality": "string (e.g. '720p (HLS)', 'Auto (HLS)', 'Source (MP4)', 'Trailer (MP4)')",
    "format": "hls | mp4",
    "ext": "m3u8 | mp4",
    "type": "hls | mp4",
    "height": "number | null",
    "bandwidth": "number | null",
    "fps": "number | null",
    "extraParams": "object | null"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "livePollIntervalMs": 1400,
    "liveIdleLimitWithData": 35,
    "liveIdleLimitNoData": 12,
    "liveMaxPlaylistErrors": 8,
    "liveFirstBatchLimit": 8,
    "liveTickTailLimit": 4,
    "llHlsSupport": true,
    "referer": "https://dreamcamtrue.com/",
    "origin": "https://dreamcamtrue.com"
  },
