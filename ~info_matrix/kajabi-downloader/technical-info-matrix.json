  "multiPlatformDetection": [
    {
      "platform": "Loom",
      "detectorFile": "detectors/loom-detector.js",
      "detectionMethods": [
        "Iframe embeds (loom.com/embed, loom.com/share)",
        "Video elements with data attributes",
        "Video elements with Loom classes/IDs",
        "Direct links",
        "Script tags"
      ],
      "handlerFile": "handlers/loom-handler.js",
      "downloadMethod": "GraphQL API (GetVideoSSR) -> CDN URL"
    },
    {
      "platform": "Vimeo",
      "detectorFile": "detectors/vimeo-detector.js",
      "detectionMethods": [
        "window.playerConfig",
