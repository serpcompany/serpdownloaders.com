  "udemyApiIntegration": {
    "lectureData": {
      "endpoint": "GET /api-2.0/users/me/subscribed-courses/{courseId}/lectures/{lectureId}",
      "fields": "title,description,view_html,asset",
      "assetFields": "asset_type,stream_url,thumbnail_url,download_urls,stream_urls,captions,data,course_is_drmed"
    },
    "lectureDataAlt": {
      "endpoint": "GET /api-2.0/courses/{courseId}/lectures/{lectureId}",
      "purpose": "Fallback for 403 errors"
    },
    "courseCurriculum": {
      "endpoint": "GET /api-2.0/courses/{courseId}/cached-subscriber-curriculum-items",
      "fields": "chapter: title,object_index; lecture: title,asset",
      "pageSize": 1000
    },
    "authCheck": {
      "method": "Cookie check for access_token on udemy.com"
    },
    "authHeaders": {
      "X-Udemy-Client-Id": "from client_id cookie",
      "X-Udemy-Bearer-Token": "from access_token cookie",
      "X-Udemy-Authorization": "Bearer {access_token}",
      "X-CSRFToken": "from csrftoken cookie",
      "X-Udemy-Snail-Case": "true",
      "X-Requested-With": "XMLHttpRequest"
    }
  },
