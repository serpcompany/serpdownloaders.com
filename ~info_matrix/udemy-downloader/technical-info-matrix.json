  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/lecture/(\\d+)",
      "/#/lecture/(\\d+)",
      "/learn/v4/t/lecture/(\\d+)"
    ],
    "courseIdSources": [
      "[data-course-id]",
      "[data-clp-course-id]",
      "script regex (course_id, courseId, ud.target.id)",
      "Udemy course page HTML fetch"
    ],
    "titleSources": [
      "h1[data-purpose=\"lecture-title\"]",
      ".lecture-title",
      ".curriculum-item-title--lecture",
      "h1",
      "Udemy API lecture.title"
    ],
    "thumbnailSources": ["meta[property=\"og:image\"]", "video[poster]", "Udemy API asset.thumbnail_url"],
    "durationSources": ["<video> element", "Udemy API asset.data.duration"],
    "extraMetadata": {
      "courseTitle": "[data-purpose=\"course-title\"]",
      "instructor": "[data-purpose=\"instructor-name\"]",
      "progress": ".progress-bar",
      "udemyLogin": "DOM + cookies (access_token, client_id, csrftoken)"
    },
    "formatSources": [
      "Udemy API download_urls.Video",
      "Udemy API stream_urls.Video",
      "Udemy API data.outputs",
      "view_html <source> tags",
      "view_html videojs-setup-data"
    ],
    "authCookieNames": ["access_token", "client_id", "csrftoken"],
    "apiEndpoints": [
      "/api-2.0/users/me/subscribed-courses/{courseId}/lectures/{lectureId}",
      "/api-2.0/courses/{courseId}/cached-subscriber-curriculum-items",
      "/api-2.0/courses/{courseId}/lectures/{lectureId}"
    ]
  },
  "formatObjectStructure": {
    "type": "direct | hls | dash",
    "url": "string",
    "title": "string",
    "quality": "2160 | 1080 | 720 | 480 | 360 | 240 | null"
  },
  "hlsProcessingSpecs": {
    "parser": "Built-in parseM3U8 (inline in background-udemy.js)",
    "masterPlaylistSupport": true,
    "segmentMerge": "Raw blob concatenation (Blob type: video/webm)",
    "outputFormat": ".mp4 filename"
  },
  "dashProcessingSpecs": {
    "parser": "Built-in parseXML (regex-based AdaptationSet/Representation extraction)",
    "mergeTool": "ffmpeg.wasm via offscreen document",
    "mergeCommand": "-i video.webm -i audio.webm -c copy output.webm",
    "fallback": "Separate audio + video file downloads on merge failure",
    "offscreenTimeoutMs": 300000
  },
  "architecture": [
    { "component": "Content Script (Udemy)", "files": ["content-udemy.js"], "purpose": "Lecture/course detection, URL extraction, auth check, curriculum parsing, SPA observer, in-page button" },
    { "component": "Content Script (Generic)", "files": ["content.js"], "purpose": "Loom-heritage generic video element/data attribute/script tag extraction" },
    { "component": "Content Script (Enhanced)", "files": ["content-enhanced.js"], "purpose": "Loom-heritage share URL detection" },
    { "component": "Service Worker", "files": ["background-udemy.js"], "purpose": "Udemy API integration, cookie auth, download orchestration (direct/HLS/DASH), ffmpeg.wasm merge, auth gating" },
    { "component": "Service Worker (Legacy)", "files": ["background-enhanced.js"], "purpose": "Loom-heritage GraphQL API, HLS/DASH pipelines, offscreen management" },
    { "component": "Popup (Udemy)", "files": ["popup-udemy.html", "popup-udemy.js"], "purpose": "Udemy UI: auth, lecture info, course list, download/download-all" },
    { "component": "Popup (Legacy)", "files": ["popup.html", "popup.js", "popup-enhanced.js"], "purpose": "Loom-heritage popup with URL input, process, download" },
    { "component": "Offscreen", "files": ["offscreen.html", "offscreen.js"], "purpose": "ffmpeg.wasm loading, audio+video WebM merge via IndexedDB" },
    { "component": "Auth", "files": ["auth.js", "auth-ui.js", "auth/"], "purpose": "OTP login, entitlements, trial (SERP Auth)" },
    { "component": "Site Config", "files": ["site-config.js"], "purpose": "Brand colors, endpoints, auth config" },
    { "component": "Update Notifier", "files": ["update-notifier.js"], "purpose": "GitHub release version checks" },
    { "component": "Trial Banner", "files": ["trial-banner.js"], "purpose": "Trial remaining badge" },
    { "component": "Inject", "files": ["inject.js"], "purpose": "Page-context fetch() monitor" },
    { "component": "Options", "files": ["options.html", "options.js"], "purpose": "Settings page" },
    { "component": "History", "files": ["history.html", "history.js"], "purpose": "Download history viewer" },
    { "component": "IndexedDB", "files": ["indexed-db.js"], "purpose": "Blob storage for ffmpeg.wasm merge" },
    { "component": "Native Messaging", "files": ["native-messaging-helper.js"], "purpose": "Optional desktop companion (yt-dlp, ffmpeg)" },
    { "component": "Worker", "files": ["worker.js"], "purpose": "ffmpeg-core.js importScripts worker" }
  ],
