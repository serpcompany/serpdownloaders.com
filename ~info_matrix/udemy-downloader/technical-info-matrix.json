      "js": "offscreen.js",
      "purpose": "ffmpeg.wasm audio/video merging for DASH streams"
    },
    "usesFFmpeg": true,
    "ffmpegMode": "ffmpeg.wasm via offscreen document",
    "usesMediaBunny": false,
    "hlsLibrary": "Built-in parseM3U8 (inline in background-udemy.js)",
    "hlsToMp4Transmuxer": null,
    "dashToMp4": "Built-in parseXML (regex-based) + ffmpeg.wasm merge",
    "mp4Box": null,
    "reencoder": null,
    "networkUtils": null,
    "indexedDB": {
      "enabled": true,
      "dbName": "LoomDownloaderDB",
      "storeName": "fileStore",
