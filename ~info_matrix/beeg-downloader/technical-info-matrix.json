    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (offscreen streaming)",
      "HLS Stitching (m3u8 segment to MP4 transmux)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from Beeg API v6 + externulls API, HTML5 video/source, script regex, Performance API CDN entries",
    "qualitySorting": "By height descending, MP4 before HLS",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "video.x-player__video",
      "nearest video container"
    ],
    "contextMenu": true,
    "contextMenuId": "download-beeg-video",
    "contextMenuTitle": "Download Beeg Video",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "Beeg/",
    "desktopNotifications": true,
    "notificationTitle": "Beeg Download Complete",
    "videoDetection": "Automatic: Beeg API v6 + externulls API, URL pattern extraction, meta tags, inject.js page-context monitor"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://beeg.com/*",
      "https://www.beeg.com/*",
