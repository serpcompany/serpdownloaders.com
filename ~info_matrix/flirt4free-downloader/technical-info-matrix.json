    "category": "Video Downloader (Adult / Live Cam)",
    "targetSites": [
      "flirt4free.com"
    ],
    "targetSiteMatches": [
      "https://flirt4free.com/*",
      "https://www.flirt4free.com/*",
      "https://*.flirt4free.com/*"
    ],
    "description": "Download Flirt4Free live streams and recordings"
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/flirt4free-downloader",
    "lastUpdated": "2026-03-06",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "flirt4free-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/flirt4free-video-downloader",
    "productPage": "https://serp.ly/flirt4free-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "HLS Stitching (m3u8 segment to MP4 transmux)",
      "Direct MP4 (offscreen streaming for VOD)",
      "HLS Live Capture (LL-HLS with start/stop)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from HLS master manifest BANDWIDTH/RESOLUTION, VOD gallery API",
    "qualitySorting": "By height and bandwidth descending",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": true,
    "liveCaptureMode": "HLS live capture with start/stop controls, LL-HLS playlistType=lowLatency",
    "vrSupport": true,
    "vrDetection": "VR camera settings (stereoPacking, frameFormat, horizontalAngle), VR filename suffix, VR badge",
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "[data-testid=\"video-player\"]",
      ".player__video-wrapper",
      ".video-player__wrapper",
      ".media-player",
      "#player-root",
      ".video-player",
      "nearest video container"
    ],
    "contextMenu": true,
    "contextMenuId": "download-flirt4free-video",
    "contextMenuTitle": "Download Flirt4Free Stream",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "FLIRT4FREE/",
    "desktopNotifications": false,
    "videoDetection": "Inject.js page-context monitor + Flirt4Free API (stream URLs, room login, video gallery)"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://*/*",
      "https://flirt4free.com/*",
      "https://www.flirt4free.com/*",
      "https://*.flirt4free.com/*"
    ],
    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://flirt4free.com/*",
        "https://www.flirt4free.com/*",
        "https://*.flirt4free.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "MP4 streaming download + HLS segment transmuxing + live HLS capture"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "Page-context HLS URL collector, Flirt4Free API calls for stream/room/video data",
      "messageType": "FLIRT4FREE_PAGE_DATA",
      "requestType": "REQUEST_FLIRT4FREE_DATA"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "Flirt4Free Stream API (flirt4free.com/ws/chat/get-stream-urls.php)",
      "Flirt4Free Room API (flirt4free.com/ws/rooms/chat-room-interface.php)",
      "Flirt4Free Videos API (flirt4free.com/api/front/v2/users/*/videos)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "flirt4free-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/flirt4free-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/flirt4free-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "pageTypeDetection": {
      "live": "Default for model room pages",
      "vod": "URL pattern /videos/ or explicit pageType=vod"
    },
    "modelIdSources": [
      "inject.js API call (model_seo_name to model_id regex)",
      "modelNumericId",
      "modelId",
      "roomSlug",
      "streamName",
      "potentialNumericIds"
    ],
    "vodUrlPattern": "/([^/]+)/videos/(\\d+)(?:/|$)",
    "titleSources": [
      "displayName",
      "modelName",
      "modelUsername",
      "document.title"
    ],
    "thumbnailSources": [
      "og:image",
      "VOD API coverUrl"
    ],
    "durationSources": [
      "VOD API duration field"
    ],
    "streamUrlSources": [
      "Flirt4Free get-stream-urls API (/ws/chat/get-stream-urls.php)",
      "inject.js global state objects (__PRELOADED_STATE__, __INITIAL_STATE__, etc.)",
      "Performance API resource entries",
      "Script tag regex for m3u8 URLs",
      "CDN host + model ID master URL construction"
    ],
    "masterUrlPattern": "https://edge-hls.{cdnHost}/hls/{streamId}/master/{streamId}_auto.m3u8",
    "cdnHostsDefault": [
      "doppiocdn.com",
      "doppiocdn.net",
      "stripcdnm.com",
      "stripcdnmd.com",
      "stripcdntmp.com",
      "sc-cdn.net"
    ],
    "mouflonDecoding": true,
    "injectMessageType": "FLIRT4FREE_PAGE_DATA",
    "injectRequestType": "REQUEST_FLIRT4FREE_DATA"
  },
  "formatObjectStructure": {
    "url": "string",
    "requestUrl": "string (with extra params applied)",
    "masterUrl": "string",
    "quality": "string (e.g. '1080p (HLS)', 'Source (MP4)', 'Trailer (MP4)', 'Auto (HLS)')",
    "format": "hls | mp4",
    "ext": "m3u8 | mp4",
    "type": "hls | mp4",
    "height": "number | null",
    "bandwidth": "number | null",
    "fps": "number | null",
    "extraParams": "object | null"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "livePollIntervalMs": 1400,
    "liveIdleLimitWithData": 35,
    "liveIdleLimitNoData": 12,
    "liveMaxPlaylistErrors": 8,
    "liveFirstBatchLimit": 8,
    "liveTickTailLimit": 4,
    "llHlsSupport": true,
    "referer": "https://flirt4free.com/",
    "origin": "https://flirt4free.com"
  },
