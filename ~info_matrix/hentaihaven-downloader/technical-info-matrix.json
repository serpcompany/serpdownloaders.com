    "formatSources": [
      "flashvars_* mediaDefinitions",
      "HTML5 <video>/<source>",
      "Script regex for mp4/m3u8 URLs",
      "Performance API resource entries from player iframe",
      "Player iframe m3u8 URL collection (VP9 + AAC variant expansion)"
    ],
    "scriptUrlRegex": "/https?:\\\\?\\/\\\\?\\/[^\"'\\\\\\s]+?\\.(?:m3u8|mp4)(?:\\\\?[^\"'\\\\\\s]*)?/gi",
    "playerIframeDetection": [
      "iframe[src*=\"/wp-content/plugins/player-logic/player.php\"]",
      "iframe[src*=\"player-logic/player.php\"]"
    ],
    "m3u8VariantExpansion": {
      "vp9QualityVariants": "vp9_*p/video.m3u8 expanded to playlist_vp9.m3u8 and playlist.m3u8",
      "audioAacVariants": "audio/aac.m3u8 expanded to playlist_vp9.m3u8 and playlist.m3u8"
    },
    "mediaRequestPatterns": [
      "/video/get_media",
      "mediaDefinitions",
      ".m3u8",
      ".mp4"
    ],
    "injectMessageType": "PORNHUB_PAGE_DATA"
  },
  "formatObjectStructure": {
    "format_id": "string",
