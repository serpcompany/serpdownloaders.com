  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Network interception (webRequest.onHeadersReceived)",
      "HLS segment fetch/transmux in content script",
      "Offscreen HLS-to-MP4 pipeline"
    ],
    "qualitySelection": true,
    "qualityMode": "Auto-detected from network traffic by MIME type and file extension; popup quality selector with height-based labels",
    "qualitySorting": "By height descending",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "downloadManagerType": "Modular (5-file architecture: config, state, UI, manager, integration helper)",
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": false,
    "contextMenu": false,
    "autoSave": true,
    "downloadFolder": "Downloads/ (browser default)",
    "desktopNotifications": false,
    "videoDetection": "Network interception via webRequest.onHeadersReceived — monitors all xmlhttprequest and media responses for media MIME types and file extensions"
  },
  "technicalDetails": {
    "permissions": [
      "webRequest",
      "webNavigation",
      "downloads",
      "tabs",
      "storage",
      "offscreen",
      "scripting",
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://*/*",
      "http://*/*"
    ],
    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "content.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "allFrames": true,
      "runAt": "document_start"
    },
    "backgroundServiceWorker": {
      "file": "background.js",
      "type": "non-module"
    },
    "offscreenDocument": {
      "html": "offscreen-hls.html",
      "js": "offscreen-hls.js",
      "purpose": "HLS segment transmuxing via HLS2MP4 module"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": false,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/hls2mp4.mjs (HLS2MP4)",
    "dashToMp4": null,
    "mp4Box": null,
    "reencoder": null,
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true,
      "file": "indexed-db.js",
      "purpose": "HLS segment caching during download"
    },
    "pageInjection": {
      "file": "page-bridge.js",
      "purpose": "Page-context fetch proxy — injected into MAIN world to make requests with page cookies/session",
      "world": "MAIN"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "m3u8-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/m3u8-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/m3u8-downloader/releases/latest"
    },
    "csp": null,
    "sandboxCsp": null,
    "dnrRules": {
      "type": "dynamic",
      "purpose": "Align Referer/Origin headers and relax CORS for HLS stream origins at runtime",
      "ruleIdOffset": 50000
    }
  },
  "videoDetectionAndExtraction": {
    "detectionMethod": "chrome.webRequest.onHeadersReceived listener on xmlhttprequest and media request types",
    "detectedExtensions": [
      "m3u8",
      "mp4",
      "mov",
      "m4v",
      "webm",
      "mpg",
      "mp3",
      "aac",
      "m4s",
      "ts",
      "flv"
    ],
    "mimeDetection": "Checks Content-Type response header for media type matches",
    "minimumFileSize": "10 KB (10240 bytes), except m3u8 and m4s which have no minimum",
    "forbiddenHostnames": [
      "youtube.com",
      "tiktok.com",
      "instagram.com",
      "vk.com",
      "dailymotion.com"
    ],
    "iconHighlight": "Sets highlight icon on tab when media is detected",
    "titleSources": [
      "meta[property=\"og:title\"]",
      "meta[name=\"twitter:title\"]",
      "document.title",
      "LD+JSON VideoObject.name"
    ],
    "thumbnailSources": [
      "og:image",
      "og:image:secure_url",
      "twitter:image",
      "LD+JSON VideoObject.thumbnailUrl",
      "largest <img> element"
    ],
    "durationSources": [
      "meta[property=\"video:duration\"]",
      "meta[itemprop=\"duration\"]",
      "LD+JSON VideoObject.duration (ISO 8601)"
    ],
    "genericMetadata": {
      "owner": "LD+JSON author.name / publisher.name",
      "dimensions": "og:video:width / og:video:height"
    }
  },
  "hlsProcessingPipeline": {
    "contentSidePipeline": "Full HLS download in content script: manifest resolution, segment fetch, IndexedDB caching, hydration, batched transfer to offscreen for transmux",
    "manifestResolution": "Recursive: resolves master playlists to best-bandwidth variant, then parses media playlist for segments",
    "bestVariantSelection": "Highest bandwidth from #EXT-X-STREAM-INF entries",
    "encryptedStreams": "Rejected — throws error if #EXT-X-KEY tag detected",
    "segmentFetchConcurrency": 2,
    "segmentRetryCount": {
      "contentScript": 6,
      "background": 3
    },
    "retryBackoff": "Exponential: 300ms * 2^attempt",
    "fetchTimeoutMs": 15000,
    "bridgeFetchTimeoutMs": 60000,
    "indexedDbPrefix": "m3u8_segment_",
    "batchTransferMaxBytes": 262144,
    "batchTransferMaxSegments": 40,
    "offscreenTransmuxer": "HLS2MP4 from modules/hls2mp4/hls2mp4.mjs",
    "keepalivePorts": [
      "VDP_HLS_KEEPALIVE",
      "VDP_HLS_OFFSCREEN_KEEPALIVE"
    ],
    "progressPhases": [
      "init",
      "manifest",
      "fetch",
      "verify",
      "hydrate",
      "transmux",
      "complete"
    ]
  },
  "networkInterception": {
    "webRequestListener": "chrome.webRequest.onHeadersReceived on <all_urls> for xmlhttprequest and media types",
    "onBeforeSendHeaders": "Monitors HLS manifest requests (.m3u8) — logs diagnostics and registers HLS context",
    "hlsContextTracking": "HLS_CONTEXT_BY_ORIGIN map — stores pageUrl, tabId, lastReferer, frameId per stream origin",
    "dnrCorsRules": "Dynamically injects declarativeNetRequest rules to modify Referer/Origin headers for cross-origin HLS segment fetches",
    "dnrRuleOffset": 50000,
    "vimeoRangeFix": "Strips &range= parameter from MP4 URLs"
  },
  "architecture": [
    {
      "component": "Content Script",
      "files": [
        "content.js"
      ],
      "purpose": "HLS manifest parsing, segment fetching with IndexedDB caching, media playlist resolution, content-side HLS download pipeline, page bridge communication"
