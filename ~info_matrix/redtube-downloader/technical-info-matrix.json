        "popup.html",
        "popup.js"
      ],
      "purpose": "UI, quality selector, auth flow"
    },
    {
      "component": "Offscreen",
      "files": [
        "offscreen.html",
        "offscreen.js"
      ],
      "purpose": "MP4 streaming + HLS transmux"
    },
    {
      "component": "Auth",
      "files": [
        "auth.js",
        "auth-ui.js"
      ],
      "purpose": "OTP login, entitlements, trial"
    },
    {
      "component": "Download Manager",
      "files": [
        "download-manager.js"
      ],
      "purpose": "In-page download progress panel"
    },
    {
      "component": "Logger",
      "files": [
        "logger.js"
      ],
      "purpose": "Structured logging, bg mirroring"
    },
    {
      "component": "Site Config",
      "files": [
        "site-config.js"
      ],
      "purpose": "Brand colors, endpoints, flags"
    },
    {
      "component": "Update Notifier",
      "files": [
        "update-notifier.js"
      ],
      "purpose": "GitHub release checks"
    },
    {
      "component": "Trial Banner",
      "files": [
        "trial-banner.js"
      ],
      "purpose": "Trial remaining badge"
    },
    {
      "component": "Inject",
      "files": [
        "inject.js"
      ],
      "purpose": "Page-context video ID extraction, embedded JSON scanning, global variable reading"
    }
  ],
