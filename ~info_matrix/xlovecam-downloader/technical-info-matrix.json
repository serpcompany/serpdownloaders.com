      "broadcastSettings": "inject.js broadcastSettings"
    },
    "formatSources": [
      "XLoveCam API hlsPlaylistFree (live streams)",
      "XLoveCam Videos API videoUrl/trailerUrl (VOD)",
      "HLS master manifest parsing (BANDWIDTH, RESOLUTION, FRAME-RATE)",
      "inject.js hlsMasterUrls collection (global state, Performance API, DOM script regex)"
    ],
    "scriptUrlRegex": "/https?:\\/\\/[^\"'\\s<>]+\\.m3u8[^\"'\\s<>]*/ig",
    "cdnDetectionPattern": "Performance API resource entries matching .m3u8",
    "mediaRequestPatterns": [
      ".m3u8",
      ".mp4",
      "hlsPlaylistFree",
      "/api/front/v2/models/",
      "/performerAction/getPerformerRoom"
    ],
    "injectMessageType": "XLOVECAM_PAGE_DATA",
    "injectRequestType": "REQUEST_XLOVECAM_DATA"
  },
  "formatObjectStructure": {
    "url": "string",
    "requestUrl": "string (with query params applied) | undefined",
    "masterUrl": "string | undefined",
    "quality": "string (e.g. '720p (HLS)', 'Auto (HLS)', 'Source (MP4)', 'Trailer (MP4)')",
    "format": "hls | mp4",
    "ext": "m3u8 | mp4",
    "type": "hls | mp4",
    "height": "number | undefined",
    "bandwidth": "number | undefined",
    "fps": "number | undefined",
    "extraParams": "object | null (psch, pkey, playlistType for LL-HLS)"
  },
