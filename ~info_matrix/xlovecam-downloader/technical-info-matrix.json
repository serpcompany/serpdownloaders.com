  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "URL path segments (last non-generic segment as model username/room slug)"
    ],
    "titleSources": [
      "inject.js displayName/modelName/modelUsername",
      "document.title"
    ],
