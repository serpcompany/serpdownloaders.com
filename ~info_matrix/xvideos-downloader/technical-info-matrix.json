    "videoDetection": "Multi-source: setVideo* script patterns, flv_url, window globals, inject.js XHR/fetch monitor, HLS manifest parsing"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
