    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "Page-context XHR/fetch monitor, extracts setVideo* URLs and metadata via window globals",
      "messageType": "XVIDEOS_PAGE_DATA"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
