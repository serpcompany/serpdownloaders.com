      "releasePageUrl": "https://github.com/serpapps/xvideos-video-downloader/releases/latest"
    },
    "csp": "script-src 'self'; object-src 'self';",
    "sandboxCsp": null,
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/video\\.?([0-9a-z]+)/"
    ],
    "titleSources": [
      "meta[property=\"og:title\"]",
      "h1",
      "document.title (cleaned)"
    ],
    "thumbnailSources": [
      "meta[property=\"og:image\"]"
    ],
    "durationSources": [
      "meta[property=\"og:duration\"]",
      "span.duration"
    ],
    "extraMetadata": {
      "description": "meta[name=\"description\"]"
    },
    "formatSources": [
      "setVideo* script patterns (setVideoHLS, setVideoUrlLow, setVideoUrlHigh)",
      "flv_url pattern",
      "HLS manifest parsing (master playlist qualities)",
      "Window globals (video_title, video_duration)",
      "mediaDefinitions fallback",
      "sources object fallback"
    ],
    "scriptUrlRegex": "/setVideo([^(]+)\\(([\"'])(http.+?)\\2\\)/g",
    "cdnDetectionPattern": null,
    "mediaRequestPatterns": [
      "xvideos",
      "media",
      "video"
    ],
    "injectMessageType": "XVIDEOS_PAGE_DATA"
  },
  "formatObjectStructure": {
    "format_id": "string (e.g. mp4-low, mp4-high, hls-720p)",
    "ext": "mp4 | m3u8",
    "format": "mp4 | hls | flv",
    "quality": "number | null",
    "url": "string",
    "height": "number | null",
    "width": "number | null",
    "qualityScore": "number",
    "bandwidth": "number | null"
  },
