        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://www.xvideos.com/*",
        "https://*.xvideos.com/*",
        "https://www.xvideos.es/*",
        "https://xvideos2.com/*",
        "https://flashservice.xvideos.com/*",
