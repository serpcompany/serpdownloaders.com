    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen-faststream.html",
      "js": [
        "offscreen-faststream-legacy.js",
        "indexed-db.js"
      ],
      "purpose": "HLS/FastStream media processing and segment stitching",
      "idleTimeoutMs": 25000,
      "readySignal": "FASTSTREAM_OFFSCREEN_READY",
      "errorSignal": "OFFSCREEN_ERROR"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "youtubeModule": "modules/youtube/ (client.js, constants.js, media-assembler.js, sabr.js, signature.js, ump.js, utils.js)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true,
      "file": "indexed-db.js",
      "purpose": "Segment caching"
    },
    "pageInjection": null,
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "Gumroad API (api.gumroad.com)",
      "Loom CDN (loomcdn.com)",
      "Vimeo Player API (player.vimeo.com)",
      "YouTube (googlevideo.com, googleapis.com)",
      "Wistia (fast.wistia.net, fast.wistia.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "gokollab-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/gokollab-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/gokollab-downloader/releases/latest"
    },
    "dnrRules": {
      "enabled": true,
      "targets": [
        "googlevideo headers",
        "YouTubei headers",
        "Skool video hosts",
        "BunnyCDN (b-cdn.net)",
        "apisystem.tech (GHL content)"
      ]
    },
    "csp": "script-src 'self'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  },
  "platformGating": {
    "gatingMarkers": [
      "meta[name=\"x-cp-build-version\"]",
      "#clientportal-siteCustomHeader",
      "script[src*=\"clientclub.net\"]",
      "link[href*=\"clientclub.net\"]"
    ],
    "gatingMessage": "GATING_DIAGNOSTIC",
    "backgroundTabCheck": {
      "function": "isGoKollabActiveTab()",
      "hostnameAllowlist": [
        "clientclub.net",
        "mykajabi.com",
        "gohighlevel.com"
      ],
      "domMarkerInspection": true
    },
    "blockedHostsRuntime": [
      "skool.com",
      "video.skool.com",
      "circle.so",
      "circle.com"
    ],
    "overlayCleanup": {
      "selector": "[data-clientclub-overlay]",
      "intervalMs": 1500,
      "mutationObserverFallback": true,
      "observerTimeoutMs": 10000
    }
  },
  "supportedVideoPlatforms": [
    {
      "platform": "Loom",
      "detector": "detectors/loom-detector.js",
      "handler": "handlers/loom-handler.js",
      "detectionMethod": "Iframe src*=\"loom.com/embed\" or loom.com/share, video ID regex, thumbnail from script tags"
    },
    {
      "platform": "Vimeo",
      "detector": "detectors/vimeo-detector.js",
      "handler": "handlers/vimeo-handler.js",
      "detectionMethod": "window.playerConfig, iframe, data attributes, player API"
    },
    {
      "platform": "YouTube",
      "detector": "detectors/youtube-detector.js",
      "handler": "handlers/youtube-handler.js",
      "detectionMethod": "Iframe embeds, direct links, video ID patterns"
    },
    {
      "platform": "Wistia",
      "detector": "detectors/wistia-detector.js",
      "handler": "handlers/wistia-handler.js",
      "detectionMethod": "Iframe src, embed/medias URL patterns, wmediaid parameter"
    },
    {
      "platform": "GoHighLevel",
      "detector": "detectors/gohighlevel-detector.js",
      "handler": "handlers/gohighlevel-handler.js",
      "detectionMethod": ".video-player-container, Plyr wrapper, native <video>, HLS m3u8 from Performance API"
    },
    {
      "platform": "Circle",
      "detector": "detectors/circle-detector.js",
      "handler": "handlers/circle-handler.js",
      "detectionMethod": "media-theme, hls-video elements, shadow DOM traversal"
    },
    {
      "platform": "Linked Videos",
      "detector": "detectors/video-detector.js (detectLinkedVideo)",
      "handler": null,
      "detectionMethod": "<a href> matching Loom/Vimeo/YouTube/Wistia/m3u8/mp4 URL regex patterns"
    }
  ],
