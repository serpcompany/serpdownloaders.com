      "https://player.vimeo.com/*",
      "https://www.loom.com/*",
      "https://*.loom.com/*",
      "https://*.loomcdn.com/*",
      "https://www.youtube.com/*",
      "https://*.youtube.com/*",
      "https://youtu.be/*",
      "https://*.googlevideo.com/*",
      "https://*.googleapis.com/*",
      "https://wistia.com/*",
