    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4/WebM download",
      "HLS stitching (offscreen FastStream)",
      "Platform-specific API extraction (Loom, Vimeo, YouTube, Wistia)"
    ],
    "qualitySelection": true,
    "qualityMode": "Per-platform quality extraction from Loom, Vimeo, YouTube, Wistia, GoHighLevel native video",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": true,
    "bulkDownloadMode": "Download Visible — downloads all detected assets on page",
    "inPagePlayerButton": false,
    "contextMenu": false,
    "autoSave": true,
    "autoSaveMode": "chrome.downloads.download() with conflictAction: uniquify, saveAs: false",
    "downloadFolder": null,
    "desktopNotifications": false,
    "videoDetection": "Multi-platform: Loom, Vimeo, YouTube, Wistia, GoHighLevel native, Circle HLS, linked video URLs; gated by HighLevel platform markers",
    "imageGifDetection": true,
    "textExtraction": true,
    "platformGating": "Content script only activates on verified GoKollab/HighLevel pages via DOM markers"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "scripting",
      "offscreen",
      "cookies",
      "declarativeNetRequestWithHostAccess"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://vimeo.com/*",
      "https://*.vimeo.com/*",
      "https://*.vimeocdn.com/*",
