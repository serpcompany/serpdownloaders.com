  "urlNormalization": {
    "permalinkNormalization": "Strips tracking params (igshid, img_index, utm_*, fbclid, mibextid, ref, refsrc), normalizes hostname to www.instagram.com, removes trailing slashes, truncates shortcodes to 11 chars",
