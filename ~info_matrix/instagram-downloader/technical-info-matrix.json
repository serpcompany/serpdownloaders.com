  "videoDetectionAndExtraction": {
    "shortcodePatterns": {
      "post": "/p/{shortcode}",
      "reel": "/reel/{shortcode} or /reels/{shortcode}",
      "igtv": "/tv/{shortcode}",
      "story": "/stories/{username}/{id}"
    },
    "shortcodeValidation": "5-11 character alphanumeric token, excludes reserved segments (audio, videos, explore, channels, discover)",
    "titleSources": [
      "document.title",
      "h2/h3/h4 author node within [role='article'] root"
    ],
    "thumbnailSources": [
      "<video poster>",
      "Largest image in article root (aspect-ratio scored, 9:16 preferred)"
    ],
    "formatSources": [
      "DOM <video> src/currentSrc/<source>",
      "Inline script known keys (playable_url_quality_hd, browser_native_hd_url, video_versions, video_url, etc.)",
      "Regex mp4 URL extraction from scripts",
      "Performance API CDN resource entries",
      "Instagram GraphQL API (doc_id: 8845758582119845)",
      "Permalink HTML fetch + extraction"
    ],
    "cdnDetectionPattern": "/(cdninstagram\\.com|instagram\\.com|fbcdn\\.net|fbsbx\\.com|scontent\\.)/i",
    "graphqlApi": {
      "endpoint": "https://www.instagram.com/graphql/query/",
      "docId": "8845758582119845",
      "headers": {
        "X-CSRFToken": "from csrftoken cookie",
        "X-IG-App-ID": "936619743392459",
        "X-ASBD-ID": "198387",
        "X-IG-WWW-Claim": "0",
        "X-Requested-With": "XMLHttpRequest"
      },
      "responsePath": "data.xdt_shortcode_media",
      "videoFields": [
        "video_url",
        "edge_sidecar_to_children.edges[].node.video_url"
      ],
      "imageFields": [
        "display_url",
        "thumbnail_src"
      ]
    },
    "resolutionFallbackChain": [
      "Content script DOM video",
      "Content script permalink cache",
      "Content script primary visible video",
      "Background GraphQL API",
      "Background permalink HTML fetch"
    ]
  },
  "videoKeyScoreTable": {
    "playable_url_quality_hd": 200,
    "browser_native_hd_url": 180,
    "video_hd_url": 175,
    "video_versions": 170,
    "video_url": 165,
    "playable_url": 160,
    "browser_native_sd_url": 150,
    "video_sd_url": 145,
    "progressive_url": 140,
    "regex_media_url": 115,
    "og_video": 105,
    "dom_video": 70,
    "playable_url_dash": 20,
    "hls_playlist_url": -120,
    "dash_manifest_url": -150
  },
  "scoringBonuses": {
    "mp4Extension": "+170 (background) / +90 (content)",
    "cdnHost": "+35",
    "instagramHost": "+10 (content only)",
    "qualityBonus": "height / 8",
    "manifestPenalty": "-180",
    "domSource": "+120 (background matching) / +40 (content)",
    "feedPermalinkSource": "+90 (background matching)",
    "posterPresent": "+60 (content dedup) / +260 (background match)",
    "permalinkPresent": "+90 (content dedup) / +540 (background match by key)"
  },
  "downloadFallbackChain": [
    {
      "step": 1,
      "method": "Direct chrome.downloads.download(url)",
      "condition": "First attempt with CDN URL"
    },
    {
      "step": 2,
      "method": "Authenticated blob fetch + blob download",
      "condition": "If direct download throws error"
    },
    {
      "step": 3,
      "method": "Page-side fetch + <a> click download",
      "condition": "If auth blob fallback fails"
    },
    {
      "step": 4,
      "method": "Auth-fetch retry after SERVER_FORBIDDEN",
      "condition": "If chrome download interrupted with SERVER_FORBIDDEN"
    },
    {
      "step": 5,
      "method": "Page-side retry after interruption",
      "condition": "If auth-fetch retry fails"
    }
  ],
