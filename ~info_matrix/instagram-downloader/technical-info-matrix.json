        "id": 42002,
        "condition": "urlFilter: ||scontent.",
        "action": "Set Origin + Referer to www.instagram.com"
      },
      {
        "id": 42003,
        "condition": "requestDomains: [instagram.com]",
        "action": "Set Origin + Referer to www.instagram.com"
      }
