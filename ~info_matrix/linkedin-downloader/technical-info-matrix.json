    "tabSystem": "Three tabs: Videos, Images, Text — switches visible asset list",
    "rescanButton": "Rescan / Scanning... toggle — re-injects content script and extracts assets",
    "bulkDownload": "Download Visible — downloads all assets in current tab"
  },
