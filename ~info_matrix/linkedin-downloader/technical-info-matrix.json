{
  "extension": "linkedin-downloader",
  "coreIdentity": {
    "extensionName": "SERP LinkedIn DL",
    "slug": "linkedin-downloader",
    "geckoId": "linkedin-downloader@serpapps.com",
    "category": "Media Downloader (Professional / Social)",
    "targetSites": [
      "linkedin.com"
    ],
    "targetSiteMatches": [
      "https://linkedin.com/*",
      "https://*.linkedin.com/*"
    ],
    "description": "Download LinkedIn feed/post videos, images, and post text from visible content."
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/linkedin-downloader",
    "lastUpdated": "2026-03-05",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "linkedin-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/linkedin-downloader",
    "productPage": "https://serp.ly/linkedin-learning-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct media download (chrome.downloads API)",
      "Blob fetch fallback (fetchMediaBlob)",
      "In-page anchor fallback (downloadAssetInPage)"
    ],
    "qualitySelection": false,
    "qualityMode": "Downloads source quality as served by LinkedIn CDN",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": false,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": true,
    "bulkDownloadMode": "Download Visible — downloads all detected assets from current feed view",
    "inPagePlayerButton": false,
    "contextMenu": false,
    "autoSave": true,
    "downloadFolder": "LinkedIn Downloader/{author}/",
    "desktopNotifications": true,
    "mediaDetection": "Multi-source: HTML5 video elements, data-sources JSON attributes, Performance API resource entries, feed post images",
    "assetTypes": [
      "Videos",
      "Images",
      "Text Posts"
    ]
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "scripting",
      "notifications"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://linkedin.com/*",
      "https://*.linkedin.com/*",
      "https://media.licdn.com/*",
      "https://*.media.licdn.com/*",
      "https://dms.licdn.com/*",
      "https://*.dms.licdn.com/*"
    ],
    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "content.js"
      ],
      "matches": [
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": null,
    "usesFFmpeg": false,
    "usesMediaBunny": false,
    "hlsLibrary": null,
    "hlsToMp4Transmuxer": null,
    "dashToMp4": null,
    "mp4Box": null,
    "reencoder": null,
    "networkUtils": null,
    "indexedDB": {
      "enabled": false
    },
    "pageInjection": null,
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "linkedin-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/linkedin-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/linkedin-downloader/releases/latest"
    },
    "csp": "script-src 'self'; object-src 'self';",
    "sandboxCsp": null,
    "dnrRules": []
  },
  "mediaDetectionAndExtraction": {
    "supportedPages": [
      "/feed",
      "/feed/update/",
      "/posts/",
      "/video/",
      "/recent-activity/",
      "[data-view-name=\"feed-full-update\"]"
    ],
    "postCardSelectors": [
      "[data-view-name=\"feed-full-update\"]",
      "main li (fallback)",
      "main (fallback)"
    ],
    "maxPostsScanned": 80,
    "activityIdPattern": "activity:(\\d+)",
    "permalinkPatterns": [
      "/feed/update/urn:li:activity:\\d+",
      "/posts/[^/?#]+",
      "/video/"
    ],
    "authorSources": [
      "Profile links (/in/, /company/, /school/)",
      "Anchor text",
      "Fallback: LinkedIn Creator"
    ],
    "postTextSources": [
      "[data-view-name=\"feed-commentary\"]",
      ".update-components-text",
      "Longest <p>/<span> over 40 chars"
    ],
    "titleGeneration": "First 70 chars of post text, fallback {author} post {index}",
    "imageDetection": {
      "selector": "<img> elements",
      "sizeFilter": ">=120px natural dimensions for inclusion, >=240px for non-CDN images",
      "cdnPattern": "media.licdn.com/dms/image/",
      "contentPatterns": [
        "feedshare-",
        "article-share-",
        "videocover-"
      ],
      "exclusionPatterns": [
        "profile-displayphoto",
        "profile-displaybackgroundimage",
        "company-logo",
        "ghost",
        "emoji",
        "sprite",
        "icon",
        "ads"
      ]
    },
    "videoSources": [
      "HTML5 <video> elements (currentSrc, src)",
      "data-sources JSON attribute parsing",
      "Performance API resource entries"
    ],
    "videoStreamPatterns": [
      "dms.licdn.com/playlist/vid/dash/",
      ".mp4"
    ],
    "videoIdExtraction": "/playlist/vid/(?:dash|v2)/([^/?#]+)",
    "cdnDomains": [
      "media.licdn.com",
      "dms.licdn.com"
    ],
    "redirectHandling": "Decodes LinkedIn /redir/redirect?url= wrappers"
  },
  "assetObjectStructure": {
    "id": "string (type:source:activityId:index:url)",
    "type": "video | image | text",
    "title": "string",
    "url": "string (media URL or null for text)",
    "text": "string (text posts only)",
    "extension": "string (mp4, jpg, etc.)",
    "source": "string (Video element | In-page blob stream | Embedded source metadata | Detected stream request | Feed image | Post content)",
    "author": "string",
    "permalink": "string (post URL)",
    "pageUrl": "string (current page URL)",
    "thumbnail": "string | null (video poster)",
    "published": "null"
  },
  "downloadPipeline": {
    "authCheck": "ensureDownloadAccess() — verifies activation + trial/license status",
    "textDownloads": "Builds plain-text document with title, post URL, text content, capture timestamp; downloads via data URL",
    "mediaDownloadFallbacks": [
      "Direct chrome.downloads.download()",
      "Fallback: fetch blob with referrer + create object URL",
      "Fallback: delegate to in-page anchor click (downloadAssetInPage)"
    ],
    "blobUrlHandling": "Delegated to content script downloadAssetInPage — creates <a> anchor and triggers click",
    "filenameFormat": "LinkedIn Downloader/{author}/{date} - {title}.{ext}",
    "filenameSanitization": "Strips \\/:*?\"<>|, collapses whitespace, max 72 chars author / 96 chars title",
    "extensionNormalization": {
      "video": "m3u8/mpd/txt/json/xml -> mp4",
      "image": "validates jpg/jpeg/png/gif/webp/avif/bmp, defaults jpg"
    },
    "conflictAction": "uniquify",
    "objectUrlCleanup": "Tracks object URLs by download ID, revokes on complete/interrupted"
  },
  "architecture": [
    {
      "component": "Content Script",
      "files": [
        "content.js"
      ],
      "purpose": "Feed/post scanning, video/image/text extraction, post card parsing, Performance API stream detection"
    },
    {
      "component": "Service Worker",
      "files": [
        "background-enhanced.js"
      ],
      "purpose": "Download orchestration, auth gating, blob fetch fallback, text document generation, filename building"
    },
    {
      "component": "Popup",
      "files": [
        "popup.html",
        "popup.js"
      ],
      "purpose": "UI, asset list with tabs (Videos/Images/Text), bulk download, rescan"
    },
    {
      "component": "Auth",
      "files": [
        "auth.js",
        "auth/auth-api.js",
        "auth/auth-config.js",
        "auth/auth-storage.js",
        "auth/auth-telemetry.js",
        "auth/auth-token.js"
      ],
      "purpose": "OTP login, entitlements, trial"
    },
    {
      "component": "Logger",
      "files": [
        "logger.js"
      ],
      "purpose": "Structured logging, bg mirroring"
    },
    {
      "component": "Site Config",
      "files": [
        "site-config.js"
      ],
      "purpose": "Brand colors, endpoints, flags"
    },
    {
      "component": "Update Notifier",
      "files": [
        "update-notifier.js"
      ],
      "purpose": "GitHub release checks"
    },
    {
      "component": "Trial Banner",
      "files": [
        "trial-banner.js"
      ],
      "purpose": "Trial remaining badge"
    },
    {
      "component": "Auth UI",
      "files": [
        "auth-ui.js"
      ],
      "purpose": "Auth screen rendering"
    },
    {
      "component": "Popup UI Overrides",
      "files": [
        "popup-ui-overrides.js"
      ],
      "purpose": "Popup customizations"
    }
  ],
  "popupUI": {
    "stylesheets": [
      "styles/popup-enhanced.css (14.9 KB)"
    ],
    "scriptLoadOrder": [
      "site-config.js",
