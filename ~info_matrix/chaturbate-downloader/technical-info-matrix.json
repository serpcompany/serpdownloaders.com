    ],
    "offscreenConstants": {
      "livePollIntervalMs": 1400,
      "liveIdleLimitWithData": 35,
      "liveIdleLimitNoData": 12,
      "liveMaxPlaylistErrors": 8,
      "liveFirstBatchLimit": 8,
      "liveTickTailLimit": 4,
      "maxSegmentRetries": 3,
      "backoffBaseMs": 500,
      "stallTimeoutMs": 30000
    }
  },
  "vodSpecs": {
