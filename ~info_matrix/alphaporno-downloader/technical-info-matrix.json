      "Script variables",
      "<video> tags",
      "<source> tags",
      "og:video meta"
    ],
    "urlRegex": "/(video_url|videoUrl|file|file_url|fileUrl|src|url)\\s*[:=]\\s*[\"']([^\"']+(?:\\.mp4|\\.m3u8)[^\"']*)[\"']/gi",
    "filteredUrls": [
      "timelines.php",
      "sprite",
      "vtt=",
      "thumbnail",
      "thumb",
      "preview"
    ],
    "qualityParseRegex": "/_(\\d{3,4})p\\.|\\/( \\d{3,4})p(?:\\/|[?#]|$)/"
  },
