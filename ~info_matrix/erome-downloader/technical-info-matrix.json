    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://erome.com/*",
        "https://www.erome.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
