    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (311 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "Page-context XHR/fetch monitor, scans playervars/mediaDefinitions, extracts media URLs",
      "messageType": "EROME_PAGE_DATA"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "erome-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/erome-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/erome-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": [
      {
        "id": 4701,
        "priority": 1,
        "action": "modifyHeaders — sets Referer to https://www.erome.com/",
        "condition": "Requests matching erome.com (types: xmlhttprequest, media, other)"
      }
    ]
  },
