      "HLS Stitching (m3u8 segment to MP4 transmux)",
      "Direct Image Download"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from HTML5 video/source elements, inline script regex, global window objects, inject.js XHR/fetch monitor",
    "qualitySorting": "By height descending, MP4 before HLS",
    "authRequired": "OTP (email verification via auth.serp.co)",
