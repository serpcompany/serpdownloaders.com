    "formatSources": [
      "HTML5 <video>/<source> elements",
      "Inline script regex for mp4/m3u8 URLs",
      "Global window objects (eromePlayer, eromeConfig, __EROME_INITIAL_STATE__, __NUXT__, __INITIAL_STATE__)",
      "inject.js XHR/fetch interception"
    ],
    "scriptUrlRegex": "/https?:\\/\\/[^\"'\\s]+?\\.(?:mp4|m3u8)(?:[^\"'\\s]*)/gi",
    "xhrFetchMonitor": "Intercepts requests matching erome, externulls, or video in URL",
    "injectMessageType": "EROME_PAGE_DATA"
  },
