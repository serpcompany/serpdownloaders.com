    "imageDownload": true,
    "imageSelectors": [
      ".album-photo img",
      ".album img",
      ".gallery img",
      ".post-content img",
      ".viewer img",
      ".media img[data-full]"
    ],
    "contextMenu": true,
    "contextMenuId": "download-erome-video",
    "contextMenuTitle": "Download Erome Video",
    "contextMenuContexts": [
      "page",
      "video"
