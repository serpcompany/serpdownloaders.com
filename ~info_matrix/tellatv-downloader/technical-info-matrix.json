  "videoDetectionAndExtraction": {
    "domainPattern": "/(^|\\.)tella\\.tv$/i",
    "manifestUrlPattern": "https://prod-stream.tella.tv/media/(manifest|rendition).m3u8",
    "signedUrlParameters": [
      "Policy",
      "Signature",
      "Key-Pair-Id",
      "Expires",
      "story_id",
      "media_type"
    ],
    "storyIdSources": [
      "URL story_id query parameter",
      "URL path /video/{storyId}",
      "Manifest URL parameters"
    ],
    "titleSources": [
      "h1",
      "[role='dialog'] main h2",
      "dialog main h2",
      "meta[property='og:title']",
      "document.title"
    ],
    "thumbnailSources": [
      "meta[property='og:image']",
      "video[poster]"
    ],
    "durationSources": [
      "<video> element .duration property"
    ],
    "manifestSources": [
      "Performance API resource timing entries",
      "HTML regex scan for prod-stream.tella.tv URLs",
      "iframe src/data-src attributes",
      "All-frames scripting.executeScript scan"
    ],
    "embedDetectionPattern": "https://(?:www\\.)?tella\\.tv/video/[^/?#]+(?:/embed)?",
    "manifestRanking": {
      "manifestM3u8": 50,
      "renditionM3u8": 30,
      "videoMediaType": 15,
      "audioMediaType": -25,
      "signedParams": 20,
      "freshnessBonus": "up to +40",
      "nearExpiryPenalty": -200
    },
    "manifestExpiryCheck": "Parses Expires parameter or decodes AWS CloudFront Policy base64 for AWS:EpochTime, 30-second skew"
  },
  "tellaDownloadPipeline": {
    "handlerClass": "TellaHandler extends SkoolHandler",
    "manifestResolution": [
      "Stored detectedVideo from chrome.storage",
      "Top-frame query via sendMessage",
      "All-frames scan via scripting.executeScript",
      "Warmup + playback refresh",
      "Page HTML fetch with manifest extraction",
      "Detached background tab view (acquireFreshManifestFromStoryView)"
    ],
    "warmupPlayback": {
      "method": "Programmatic play button click + video.play() on muted videos",
      "waitMs": 1600,
      "playButtonSelectors": [
        "button[aria-label*='Play']",
        "button[title*='Play']",
        "[data-testid*='play']",
        ".vjs-big-play-button",
        ".plyr__control--overlaid",
        ".mejs__overlay-button",
        ".play-button"
      ]
    },
    "manifestRefresh": "Opens background tab to tella.tv/video/{storyId}/view, waits for tab complete, re-scans",
    "retryOn403": true,
    "maxConcurrentDownloads": 3,
    "segmentDownload": "Delegates to SkoolHandler.downloadSegmentsDirect() — direct or proxy-based fallback"
  },
  "overlayButtonConfig": {
    "containerTargets": [
      "media-theme",
