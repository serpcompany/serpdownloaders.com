    "desktopNotifications": true,
    "notificationTitle": "Download completed",
    "videoDetection": "Multi-source: signed HLS manifests from prod-stream.tella.tv, Performance API resource entries, iframe embed detection, HTML regex scan, all-frames scan"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
