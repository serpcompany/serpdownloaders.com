  "videoDetectionAndExtraction": {
    "modelIdSources": [
      "modelId from page data",
      "modelNumericId from page data",
      "roomSlug from URL path",
      "modelUsername from page data",
      "Streamate Front API (/api/front/v2/models/username/{slug}/cam)"
    ],
    "titleSources": [
      "displayName",
      "modelName",
      "modelUsername",
      "document.title"
    ],
    "thumbnailSources": [
      "og:image"
    ],
    "pageTypeDetection": {
      "live": "Default for model room pages",
      "vod": "URL pattern: /{model}/videos/{id}"
    },
    "formatSources": [
      "Streamate Manifest Server (manifest-server.naiadsystems.com/live/s:{model}.json)",
      "Streamate Front API (/api/front/v2/models/username/{slug}/cam)",
      "HLS master playlist probing across CDN hosts",
      "inject.js page state collection"
    ],
    "cdnHostDetection": [
      "doppiocdn.com",
      "doppiocdn.net",
      "stripcdnm.com",
      "stripcdnmd.com",
      "stripcdntmp.com",
      "sc-cdn.net",
      "strpst.com"
    ],
    "mediaRequestPatterns": [
      ".m3u8",
      "manifest-server.naiadsystems.com",
      "HLS master/variant playlists"
    ],
    "injectMessageType": "STREAMATE_PAGE_DATA",
    "mouflonKeyDecryption": true
  },
  "formatObjectStructure": {
    "type": "hls | mp4",
    "quality": "string (e.g. '1080p')",
    "url": "string",
    "format": "string (e.g. 'HLS')",
    "height": "number | null",
    "requestUrl": "string | null",
    "extraParams": "object | null"
