    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/([a-z0-9]+)/(?:video|play|embed)"
    ],
    "titleSources": [
      "h1[title] attribute",
      "document.title (stripped of ' - SpankBang' suffix)"
    ],
    "thumbnailSources": [
      "meta[property=\"og:image\"]"
    ],
    "durationSources": [],
    "extraMetadata": {
      "uploader": "field (populated if available)",
      "uploader_id": "field (populated if available)",
      "views": "field (populated if available)",
      "description": "field (populated if available)"
    },
    "formatSources": [
      "stream_url_* page variables (script-tag regex in inject.js)",
      "SpankBang API via data-streamkey POST to /api/videos/stream",
      "window.initials legacy fallback",
      "xplayerSettings legacy fallback"
    ],
    "streamUrlRegex": "/stream_url_([^\\s=]+)\\s*=\\s*([\"'])((?:(?!\\2).)+)\\2/g",
    "formatTypeDetection": "URL-based: .m3u8 = HLS, .mpd = DASH, otherwise MP4",
    "mediaRequestPatterns": [
      "spankbang",
      "media",
      "video"
    ],
    "injectMessageType": "SPANKBANG_PAGE_DATA"
  },
  "formatObjectStructure": {
    "url": "string",
    "quality": "string (e.g. '1080p (MP4)' or '720p (HLS)')",
    "format": "mp4 | hls",
    "ext": "mp4 | hls",
    "height": "number | null",
    "id": "string (e.g. 'stream-240p')",
    "type": "mp4 | hls"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "referer": "https://spankbang.com/",
    "m3u8Parsing": "Recursive — selects highest bandwidth variant from master playlist, then extracts segment URLs"
  },
