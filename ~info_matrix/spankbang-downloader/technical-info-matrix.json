        "site-config.js",
        "logger.js",
        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://spankbang.com/*",
        "https://*.spankbang.com/*",
        "https://m.spankbang.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "MP4 streaming download + HLS segment transmuxing"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "Page-context script-tag parsing for stream_url_* variables, XHR/fetch monitor, window.initials detection",
      "messageType": "SPANKBANG_PAGE_DATA"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "SpankBang API (spankbang.com/api/videos/stream)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "spankbang-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/spankbang-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/spankbang-video-downloader/releases/latest"
    },
