      "#main_video_player",
      ".player"
    ],
    "contextMenu": true,
    "contextMenuId": "download-spankbang-video",
    "contextMenuTitle": "Download SpankBang Video",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "Downloads/",
    "desktopNotifications": true,
    "notificationTitle": "SpankBang Download Complete",
    "videoDetection": "Automatic — inject.js script-tag parsing for stream_url_* variables, SpankBang API via data-streamkey, XHR/fetch monitoring, window.initials fallback"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://spankbang.com/*",
      "https://*.spankbang.com/*",
      "https://m.spankbang.com/*"
    ],
