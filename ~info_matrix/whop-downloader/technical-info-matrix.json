        "matches": [
          "https://whop.com/*",
          "https://*.whop.com/*"
        ],
        "allFrames": false,
        "runAt": "document_idle"
      },
      {
        "files": [
          "site-config.js",
          "logger.js",
          "content-enhanced.js"
        ],
        "matches": [
          "https://whop.com/*",
          "https://*.whop.com/*"
        ],
        "allFrames": true,
        "runAt": "document_idle"
      }
