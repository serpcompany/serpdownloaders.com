    "assetTypes": [
      "video",
      "image",
      "text"
    ],
    "videoSources": [
      "HTML5 <video> elements (src, currentSrc, <source>)",
      "Mux players (<mux-player>, <mux-video>)",
      "og:video meta tags"
    ],
    "imageSources": [
      "All visible <img> elements on the page"
    ],
    "textSources": [
      "Visible text post content from Whop feed/lesson pages"
    ],
    "muxDetection": {
      "elements": [
        "mux-player",
        "mux-video"
      ],
      "playbackIdExtraction": true,
      "streamHost": "stream.mux.com"
