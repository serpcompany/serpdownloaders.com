  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4/image download",
      "HLS stitching via offscreen FastStream (fMP4 segment merge)"
    ],
    "qualitySelection": true,
    "qualityMode": "Best progressive MP4 selected automatically from PinResource API video_list, DOM <video>, inline script data, and thumbnail-derived URLs",
    "qualitySorting": "By height descending, then width descending; progressive MP4 preferred over HLS/DASH manifests",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "downloadManagerType": "Modular (download-manager/ directory with 6 files)",
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": true,
    "bulkDownloadMethod": "Download Visible button downloads all visible pins on current page",
    "inPagePlayerButton": false,
    "overlayButtons": true,
    "overlayButtonAnchor": "Pinterest Save button — inserted as sibling before Save in parent container",
    "contextMenu": false,
    "autoSave": true,
    "downloadFolder": "Pinterest Downloader/",
    "desktopNotifications": false,
    "videoDetection": "Multi-source: DOM <video> elements, inline script data (playable_url keys), PinResource API, pinimg.com thumbnail-to-video derivation, feed permalink resolution",
    "imageDetection": "DOM <img> elements on pinimg.com with minimum 180x180 size, sorted by area",
    "textExtraction": "Post text from visible pins, saved as .txt files",
    "assetTypes": [
      "video",
      "image",
      "text"
    ]
  },
