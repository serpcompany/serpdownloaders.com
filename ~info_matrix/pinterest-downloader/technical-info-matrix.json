  "videoDetectionAndExtraction": {
    "pinIdPattern": "/pin/(?:[\\w-]+--)?(\\d{5,})",
    "titleSources": [
      "document.title",
      "h2/h3/h4 in post root (author name)"
    ],
    "thumbnailSources": [
      "<video> poster attribute",
      "Largest <img> in post root by area (aspect-ratio scored)"
    ],
    "durationSources": [
      "Duration badge in root (\\d{1,2}:\\d{2} pattern in span/div text)"
    ],
    "postRootSelectors": [
      "div[role='listitem']",
      "article",
      "[role='article']",
      "[data-pagelet*='FeedUnit']",
      "div[aria-posinset]"
    ],
    "videoSignalDetection": [
      "<video> element",
      "img[src*='/videos/thumbnails/']",
      "thumbnail-derived URLs",
      "duration badge",
      "[aria-label*='video' i]",
      "[aria-label*='play' i]",
      "[data-test-id*='video' i]"
    ],
    "formatSources": [
      "DOM <video>/<source> elements",
      "Inline script keys (playable_url_quality_hd, playable_url, browser_native_hd_url, video_url, etc.)",
      "PinResource API (/resource/PinResource/get/)",
      "Thumbnail-to-video URL derivation (pinimg.com paths)"
    ],
    "inlineScriptKeys": [
      "playable_url_quality_hd",
      "playable_url",
      "playable_url_dash",
      "browser_native_hd_url",
      "browser_native_sd_url",
      "progressive_url",
      "hls_playlist_url",
      "dash_manifest_url",
      "video_versions",
      "video_url"
    ],
    "scriptUrlRegex": "/https?:\\\\/\\\\/[^\"'\\s<>]+?\\.(?:mp4)[^\"'\\s<>]*/gi",
    "cdnDetectionPattern": "pinimg.com and pinterest.com via FB_MEDIA_HOST_RE",
    "pinResourceApi": {
      "endpoint": "/resource/PinResource/get/",
      "fieldSetKey": "unauth_react_main_pin",
      "videoListPaths": [
        "videos.video_list",
        "story_pin_data.pages[].blocks[].video.video_list"
      ],
      "headers": {
        "Accept": "application/json, text/javascript, */*; q=0.01",
        "X-Requested-With": "XMLHttpRequest",
        "X-Pinterest-PWS-Handler": "www/[username].js"
      }
    },
    "thumbnailDerivation": {
      "from": "pinimg.com /videos/thumbnails/originals/ or /videos/thumbnails/",
      "to": "/videos/mc/720p/ with .jpg to .mp4 extension swap"
    }
  },
  "videoCandidateScoring": {
    "keyScores": {
      "playable_url_quality_hd": 180,
