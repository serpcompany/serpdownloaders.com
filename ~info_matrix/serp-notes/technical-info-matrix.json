{
  "extension": "serp-notes",
  "coreIdentity": {
    "extensionName": "SERP Notes",
    "slug": "serp-notes",
    "geckoId": "serp-notes@serpapps.com",
    "category": "Productivity / Notes & Organization",
    "targetSites": [],
    "targetSiteMatches": [],
    "description": "Offline-first markdown notes with SERP authentication and trial access."
  },
  "versionAndStatus": {
    "manifestVersion": "1.0.0",
    "packageVersion": "1.0.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/serp-notes",
    "lastUpdated": "2026-03-05",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": null,
    "storeSanitizedFile": null,
    "githubReleasesRepo": "serpapps/serp-notes",
    "productPage": "https://serp.ly/serp-notes",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "primaryFunction": "Create, organize, and sync markdown notes with AI assistance, voice transcription, and live sharing",
    "markdownEditor": "Full markdown authoring with headings (H1-H4), bold, italic, strikethrough, bullet lists, todo/checkbox lists, code blocks, links, and inline images",
    "sidePanel": true,
    "sidePanelFile": "sidepanel.html",
    "omnibox": true,
    "omniboxKeyword": "sn",
    "keyboardShortcut": "Ctrl+Shift+Y",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialIncluded": true,
    "trialUnit": "note",
    "cloudSync": true,
    "cloudSyncApi": "notes.serp.co",
    "cloudSyncDebounceMs": 900,
    "cloudSyncFetchTimeoutMs": 7000,
    "offlineFirst": true,
    "serpyAiAgent": true,
    "serpyAssistEndpoint": "/ai/assist",
    "voiceTranscription": true,
    "voiceTranscribeEndpoint": "/ai/transcribe",
    "voiceMaxRecordMs": 25000,
    "voiceTranscribeTimeoutMs": 45000,
    "webContextCapture": true,
    "webContextMaxChars": 24000,
    "webContextMaxBlocks": 900,
    "webContextRefreshMs": 45000,
    "liveSharing": true,
    "liveSharingModes": ["live", "snapshot"],
    "shareBaseUrl": "https://notes.serp.co",
    "imageSupport": true,
    "imageMaxBytes": 5242880,
    "imageFormats": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/avif"],
    "snapshotSnipping": true,
    "folders": true,
    "defaultFolder": "General",
    "tags": true,
    "pinning": true,
    "search": true,
    "searchFilters": ["all", "pinned", "page"],
    "wikiLinks": true,
    "slashCommands": true,
    "commandPalette": true,
    "livePreview": true,
    "previewMode": true,
    "copyRichText": true,
    "exportFormats": ["md", "txt", "docx", "html", "pdf"],
    "exportAll": true,
    "exportJson": true,
    "importJson": true,
    "duplicateNote": true,
    "contextMenu": true,
    "contextMenuItems": [
      "Save selection to current SERP note",
      "Save selection as new SERP note"
    ],
    "badgeCount": true,
    "desktopNotifications": false,
    "statsDashboard": true,
    "statsFields": ["totalNotes", "pinned", "wordCount", "totalImages"]
  },
  "technicalDetails": {
    "permissions": [
      "storage",
      "downloads",
      "sidePanel",
      "contextMenus",
      "tabs",
      "activeTab",
      "scripting"
    ],
    "hostPermissions": [
      "<all_urls>",
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://notes.serp.co/*",
      "https://serp-notes-api.serpcompany.workers.dev/*"
    ],
    "contentScripts": null,
    "backgroundServiceWorker": {
      "file": "background.js",
      "type": "module"
    },
    "sidePanel": {
      "defaultPath": "sidepanel.html"
    },
    "offscreenDocument": null,
    "usesFFmpeg": false,
    "usesMediaBunny": false,
    "uiFramework": "Vanilla JavaScript (no build framework)",
    "cssFramework": "Custom CSS with design tokens (dark mode, color-scheme: dark)",
    "markdownRendering": "Custom markdown-to-HTML rendering in preview panel",
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "SERP Notes API (notes.serp.co / serp-notes-api.serpcompany.workers.dev)",
      "GitHub Releases API (api.github.com)",
      "Cloudflare AI (Serpy assist and transcription)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "serp-notes",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/serp-notes/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/serp-notes/releases/latest"
    },
    "csp": "Default MV3 CSP (no custom overrides)",
    "dnrRules": []
  },
  "storageSchema": {
    "workspace": "serp-notes:workspace",
    "settings": "serp-notes:settings",
    "syncDebug": "serp-notes:sync-debug",
    "pendingCapture": "serp-notes:pending-capture",
    "pendingSnapshot": "serp-notes:pending-snapshot-image",
    "micGranted": "serp-notes:mic-granted",
    "authToken": "serp-notes:token",
    "authEntitlements": "serp-notes:entitlements",
    "authExpiresAt": "serp-notes:expiresAt",
    "authSessionToken": "serp-notes:sessionToken",
    "authDeviceId": "serp-notes:deviceId",
    "authEmail": "serp-notes:email",
    "activatedFlag": "isActivated"
  },
  "noteObjectStructure": {
    "id": "string (UUID)",
    "title": "string",
    "content": "string (markdown)",
    "pinned": "boolean",
    "folder": "string (default: General)",
    "tags": ["string"],
    "sourceUrl": "string (URL of page when note was created)",
    "createdAt": "number (Unix timestamp ms)",
    "updatedAt": "number (Unix timestamp ms)",
    "deletedAt": "number | null (soft delete timestamp)"
  },
  "cloudSyncArchitecture": {
    "syncModel": "Offline-first with debounced cloud push",
    "pushDebounceMs": 900,
    "fetchTimeoutMs": 7000,
    "maxSyncedNotes": 400,
    "cloudStatusStates": ["idle", "checking", "syncing", "connected", "offline", "error"],
    "conflictResolution": "Last-write-wins based on updatedAt timestamp"
  },
  "shareLinkSchema": {
    "share_id": "string (UUID, primary key)",
    "user_id": "string",
    "note_id": "string",
    "mode": "live | snapshot",
    "snapshot_title": "string | null",
    "snapshot_content": "string | null",
    "is_revoked": "boolean (0/1)",
    "expires_at": "number | null",
    "created_at": "number (Unix timestamp)",
    "updated_at": "number (Unix timestamp)",
    "view_count": "number",
    "download_count": "number"
  },
  "aiSerpyFeatures": {
    "assistEndpoint": "/ai/assist",
    "transcribeEndpoint": "/ai/transcribe",
    "maxRecordDurationMs": 25000,
    "minRecordDurationMs": 450,
    "transcribeTimeoutMs": 45000,
    "transcribeHardTimeoutMs": 60000,
    "pageContextMaxChars": 24000,
    "pageContextMaxBlocks": 900,
    "pageContextRefreshMs": 45000,
    "maxAudioUploadBytes": 10485760,
    "aiProvider": "Cloudflare AI binding",
    "serpyOutputActions": ["Apply edit", "Undo", "Copy reply", "Close"]
  },
  "architecture": [
    { "component": "Popup / Main UI", "files": ["popup.html", "popup.js"], "purpose": "Full note workspace — editor, notes list, search, filters, folders, tags, Serpy AI bar, export, sharing, stats" },
    { "component": "Side Panel", "files": ["sidepanel.html"], "purpose": "Identical UI rendered in Chrome side panel with layout adaptations" },
    { "component": "Service Worker", "files": ["background.js"], "purpose": "Context menus, tab badge counts, pending capture queue, snapshot capture/crop, side panel management, auth listener" },
    { "component": "Auth", "files": ["auth.js", "auth-ui.js"], "purpose": "OTP login, entitlement checks, trial management" },
    { "component": "Auth Modules", "files": ["auth/auth-api.js", "auth/auth-config.js", "auth/auth-storage.js", "auth/auth-telemetry.js", "auth/auth-token.js"], "purpose": "Modular auth subsystem" },
    { "component": "Site Config", "files": ["site-config.js"], "purpose": "Brand colors, endpoints, feature flags, auth config, pricing text, upgrade features" },
    { "component": "Update Notifier", "files": ["update-notifier.js"], "purpose": "GitHub release version checks" },
    { "component": "Trial Banner", "files": ["trial-banner.js"], "purpose": "Free trial remaining badge" },
    { "component": "Logger", "files": ["logger.js"], "purpose": "Structured logging with level hierarchy and background mirroring" },
    { "component": "Mic Permission", "files": ["mic-permission.html", "mic-permission.js"], "purpose": "Dedicated page for granting microphone access for voice transcription" },
    { "component": "Cloudflare Worker", "files": ["cloudflare/serp-notes-api/src/index.js"], "purpose": "Server-side API — cloud sync, live sharing, image upload (R2), AI assist, AI transcribe" },
    { "component": "Cloudflare D1", "files": ["cloudflare/serp-notes-api/migrations/0001_init.sql", "cloudflare/serp-notes-api/migrations/0002_share_links.sql"], "purpose": "Database schema for notes and note_shares tables" },
    { "component": "Styles", "files": ["styles/popup.css"], "purpose": "Dark-theme CSS with design tokens, responsive popup and side panel layouts" }
  ],
  "popupAndSidePanelUI": {
    "stylesheets": ["styles/popup.css"],
    "scriptLoadOrder": ["site-config.js", "logger.js", "auth.js (module)", "popup.js (module)", "auth-ui.js (defer)", "trial-banner.js (defer)", "update-notifier.js (defer)"],
    "popupDimensions": { "width": "640px", "height": "600px" },
    "sidePanelDimensions": { "width": "100%", "height": "100vh" },
    "splitLayoutMinWidth": 760,
    "sections": [
      "Boot splash",
      "Auth/activation gate",
      "Trial banner",
      "Stats row (total notes, pinned, words, images)",
      "Notes list with search/filter/folders/tags",
      "Markdown editor with formatting toolbar",
      "Serpy AI bar with voice transcription",
      "Preview panel",
      "Backlinks panel",
      "Footer with export/share/shortcuts"
    ],
    "overlays": [
      "Command palette",
      "Export format picker",
      "Keyboard shortcuts reference",
      "Web context debug viewer",
      "Insert image dialog"
    ],
    "theme": "Dark mode — color-scheme: dark, CSS custom properties from site-config.js COLORS"
  },
  "keyboardShortcuts": [
    { "shortcut": "Ctrl/Cmd + N", "action": "New note" },
    { "shortcut": "Ctrl/Cmd + B", "action": "Bold" },
    { "shortcut": "Ctrl/Cmd + I", "action": "Italic" },
    { "shortcut": "Ctrl/Cmd + Shift + X", "action": "Strikethrough" },
    { "shortcut": "Ctrl/Cmd + Shift + L", "action": "Bullet list" },
    { "shortcut": "Ctrl/Cmd + Shift + T", "action": "Todo list" },
    { "shortcut": "Ctrl/Cmd + S", "action": "Force cloud sync" },
    { "shortcut": "Ctrl/Cmd + F", "action": "Focus search" },
    { "shortcut": "Ctrl + Shift + Y", "action": "Open side panel" },
    { "shortcut": "/", "action": "Slash commands" },
    { "shortcut": "[[", "action": "Wiki link autocomplete" },
    { "shortcut": "Ctrl/Cmd + P", "action": "Command palette" },
    { "shortcut": "Esc", "action": "Close panel / back" }
  ],
  "buildAndRelease": {
    "buildTool": "build.js (Node.js script using PowerShell Compress-Archive)",
    "viteBundled": false,
    "watermarked": true,
    "githubRelease": true,
    "githubRepo": "serpapps/serp-notes",
    "hasWorktree": true,
    "worktreePath": ".worktrees/serp-notes/"
  },
  "testingAndHealth": {
    "working": null,
    "lastTestedDate": null,
    "knownIssues": null,
    "userReports": null
  },
  "businessAndMonetization": {
    "pricingModel": "Freemium — free tier for testing, Pro tier at $9/month",
    "proTierFeatures": [
      "Unlimited notes",
      "Up to 10,000 images stored",
      "Unlimited live shares",
      "Serpy AI note agent",
      "Voice transcription to notes",
      "Create AI notes from web pages",
      "Web context capture (headings, lists, tables, code)",
      "Cloud sync",
      "Export all formats (.md, .txt, .docx, HTML/PDF, ZIP)",
      "Priority feature updates"
    ],
    "gumroadProductId": null,
    "ghLicenseId": null,
    "licenseCheckWorker": "serp-notes-api.serpcompany.workers.dev",
    "installCount": null,
    "revenuePriority": null
  },
  "loggingAndTelemetry": {
    "logLevel": "debug (source) / error (packaged builds)",
    "mirrorToBackground": true,
    "logHierarchy": "debug(10) < log(20) < warn(30) < error(40) < none(100)",
    "syncDebugLog": "serp-notes:sync-debug"
  },
  "icons": [
    { "type": "default", "size": "16x16", "file": "icons/icon16.png" },
    { "type": "default", "size": "32x32", "file": "icons/icon32.png" },
    { "type": "default", "size": "48x48", "file": "icons/icon48.png" },
    { "type": "default", "size": "128x128", "file": "icons/icon128.png" },
    { "type": "splash", "size": "variable", "file": "icons/splash-logo.png" }
