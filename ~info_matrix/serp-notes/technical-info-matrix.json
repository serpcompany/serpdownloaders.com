    },
    "d1Database": {
      "binding": "DB",
      "databaseName": "serp-notes",
      "databaseId": "e5637fb6-1b0b-4615-8018-95938bca5617"
    },
    "r2Bucket": {
      "binding": "NOTES_ASSETS",
      "bucketName": "serp-notes-assets"
    },
    "ai": {
      "binding": "AI"
    },
    "publicShareBaseUrl": "https://notes.serp.co",
    "publicAssetBaseUrl": "https://notes.serp.co/assets",
    "productUrl": "https://serp.ly/serp-notes",
    "authBaseUrl": "https://auth.serp.co",
    "authEntitlement": "serp-notes",
    "rateLimit": {
      "windowMs": 60000,
      "maxRequests": 120
    }
  },
  "dependencies": {},
  "serverSideLimits": {
    "maxSyncedNotes": 400,
    "maxImageUploadBytes": 5242880,
    "maxAudioUploadBytes": 10485760,
    "rateLimitWindowMs": 60000,
    "rateLimitMaxRequests": 120,
    "aiTranscribeTimeoutMs": 30000
  }
