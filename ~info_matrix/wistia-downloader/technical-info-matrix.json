      "wistia.com",
      "wistia.net",
      "any site with Wistia embeds"
    ],
    "targetSiteMatches": [
      "https://*.wistia.com/*",
      "https://*.wistia.net/*",
      "https://*/*"
    ],
    "description": "Download Wistia videos directly to your computer"
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
