    "githubReleasesRepo": "serpapps/wistia-video-downloader",
    "productPage": "https://serp.ly/wistia-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (chrome.downloads API with Save As)",
      "HLS Stitching (m3u8 segment to MP4 transmux via offscreen)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from Wistia embed config media.assets, sorted by quality flag then height then bitrate",
    "qualitySorting": "By quality flag descending, then height descending, then bitrate descending",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "playlistSupport": true,
    "channelSupport": true,
    "embedDetection": true,
    "inPagePlayerButton": false,
    "playerButtonTargets": null,
    "contextMenu": false,
    "contextMenuId": null,
    "contextMenuTitle": null,
    "contextMenuContexts": null,
    "autoSave": false,
    "saveAsDialog": true,
    "downloadFolder": null,
    "desktopNotifications": false,
    "notificationTitle": null,
    "videoDetection": "Multi-method: JSON-LD VideoObject, Wistia async embeds, data attributes, script tags, iframes, source elements, video elements, window._wq, element IDs/classes",
    "passwordProtectedVideos": "Detection only (error thrown)"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://*.wistia.com/*",
      "https://*.wistia.net/*",
      "https://fast.wistia.net/*",
      "https://fast.wistia.com/*",
      "https://embed-ssl.wistia.com/*",
      "https://embedwistia-a.akamaihd.net/*",
      "https://*.cloudfront.net/*"
    ],
    "contentScripts": [
      {
        "files": [
          "site-config.js",
          "logger.js",
          "download-manager/inline-manager.js"
        ],
        "matches": [
          "<all_urls>"
        ],
        "allFrames": false,
        "runAt": "document_start"
      },
      {
        "files": [
          "site-config.js",
          "logger.js",
          "content-enhanced.js"
        ],
        "matches": [
          "https://*.wistia.com/*",
          "https://*.wistia.net/*",
          "https://*/*"
        ],
        "allFrames": false,
        "runAt": "document_idle"
      }
    ],
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "HLS M3U8 playlist parsing, segment downloading, MP4 transmuxing via SimpleHLS2MP4Converter",
      "justification": "Merge HLS playlists into MP4 for Wistia downloads"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true,
      "dbName": "LoomDownloaderDB",
      "storeName": "fileStore",
      "dbVersion": 1
    },
    "pageInjection": null,
    "externalAPIs": [
      "Wistia Embed API (fast.wistia.net/embed/medias|playlists|channel/<id>.json)",
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "wistia-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/wistia-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/wistia-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPattern": "[a-z0-9]{10}",
    "detectionMethods": [
      {
        "method": 0,
        "name": "Direct Wistia URL",
        "pattern": "wistia.(?:net|com)/(?:embed/)?(?:iframe|medias|playlists|channel)/([a-z0-9]{10})"
      },
      {
        "method": 1,
        "name": "URL parameters",
        "params": [
          "wmediaid",
          "wvideo",
          "wvideoid"
        ]
      },
      {
        "method": 2,
        "name": "DOM async embeds",
        "selector": "[class*=\"wistia_async_\"]"
      },
      {
        "method": 3,
        "name": "Data attributes",
        "selectors": [
          "[data-wistia-id]",
          "[data-wistia-video-id]"
        ]
      },
      {
        "method": 4,
        "name": "Script tags",
        "patterns": [
          "Wistia.embed()",
          "wmediaid",
          "wvideo"
        ]
      },
      {
        "method": 5,
        "name": "Wistia iframes",
        "selector": "iframe[src*=\"wistia\"]"
      },
      {
        "method": 6,
        "name": "Source elements",
        "selectors": [
          "source[src*=\"wistia\"]",
          "source[src*=\"fast.wistia\"]"
        ]
      },
      {
        "method": 7,
        "name": "Video elements",
        "description": "Video src and nested source elements"
      },
      {
        "method": 8,
        "name": "Wistia queue",
        "global": "window._wq"
      },
      {
        "method": 9,
        "name": "Element IDs/classes",
        "selectors": [
          "[id*=\"wistia_\"]",
          "[class*=\"wistia_\"]"
        ]
      }
    ],
    "jsonLdDetection": {
      "selector": "script[type=\"application/ld+json\"]",
      "type": "VideoObject",
      "embedUrlPattern": "wistia.(?:net|com)/embed/iframe/([a-z0-9]{10})"
    },
    "titleSources": [
      "Wistia embed config media.name",
      "JSON-LD name/headline",
      "video[aria-label]",
      "meta[property=\"og:title\"]",
      "meta[name=\"twitter:title\"]",
      "h1",
      "title"
    ],
    "thumbnailSources": [
      "Wistia embed config assets[type=still]",
      "JSON-LD thumbnailUrl",
      "og:image",
      "twitter:image",
      ".wistia_embed img",
      "video[poster]"
    ],
    "durationSources": [
      "Wistia embed config media.duration",
      "JSON-LD ISO 8601 duration"
    ],
    "descriptionSources": [
      "Wistia embed config media.seoDescription",
      "og:description",
      "twitter:description",
      "meta[name=description]"
    ],
    "formatSources": [
      "Wistia Embed API (fast.wistia.net/embed/medias/<id>.json)",
      "Content script JSONP fallback"
    ],
    "embedConfigFallback": "Content script fetch with credentials + JSONP script injection",
    "contentTypeDetection": {
      "playlist": "URL contains /playlists/",
      "channel": "URL contains /channel/",
      "video": "Default"
    },
    "wistiaApiEndpoints": [
      "https://fast.wistia.net/embed/medias/<id>.json",
      "https://fast.wistia.net/embed/playlists/<id>.json",
      "https://fast.wistia.net/embed/channel/<id>.json"
    ]
  },
  "formatObjectStructure": {
    "format_id": "string (e.g., original, mp4_h264_1920x1080)",
    "url": "string",
    "ext": "mp4 | m3u8 | ts",
    "width": "number | null",
    "height": "number | null",
    "filesize": "number | null",
    "tbr": "number | null (bitrate)",
    "vcodec": "string | null",
    "acodec": "string | null (for audio-only)",
    "quality": "1 (original) | 0 (standard)",
    "protocol": "m3u8_native (for HLS) | undefined (for direct)",
    "format_note": "HLS | TS segments | undefined"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "m3u8Parser": "Built-in parseM3U8() in offscreen.js",
    "segmentConcurrency": 6,
    "variantSelection": "Highest bandwidth first",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "offscreenJustification": "Merge HLS playlists into MP4 for Wistia downloads"
  },
