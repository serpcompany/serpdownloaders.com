    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (offscreen streaming)",
      "HLS Stitching (m3u8 segment to MP4 transmux)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from EPorner API (/xhr/video/), HTML5 video/source, inject.js page-context extraction, script regex",
    "qualitySorting": "By height descending, MP4 before HLS",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "#EPvideo_html5_api",
      "video.vjs-tech",
      "generic <video>",
      "nearest positioned ancestor"
    ],
    "playerButtonUrlGate": "https://www.eporner.com/video",
    "contextMenu": true,
    "contextMenuId": "download-eporner-video",
    "contextMenuTitle": "Download Eporner Video",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "Eporner/",
    "desktopNotifications": true,
    "notificationTitle": "Eporner Download Complete",
    "videoDetection": "Multi-source: EPorner API (hash-based XHR), HTML5 video, inject.js page-context extraction, script regex, global variable monitoring"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://eporner.com/*",
      "https://www.eporner.com/*",
      "https://*.eporner.com/*",
