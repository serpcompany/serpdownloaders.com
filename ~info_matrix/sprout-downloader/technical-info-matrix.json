    "qualitySelection": true,
    "qualityMode": "Parsed from SproutVideo base64-encoded player data, direct download entries, HLS manifests",
    "qualitySorting": "Direct downloads preferred over HLS; sorted by quality descending, then height, then bitrate",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "downloadManagerType": "In-page download manager with task registry and inline overlay",
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
