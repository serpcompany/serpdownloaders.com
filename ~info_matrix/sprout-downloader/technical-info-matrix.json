      "repoName": "sprout-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/sprout-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/sprout-video-downloader/releases/latest"
    },
    "csp": "script-src 'self'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "videos\\.sproutvideo\\.com/embed/([a-f0-9]{18})",
      "[\\w-]+\\.vids\\.io/videos/([a-f0-9]{18})",
      "(?:embed/|videos/)([a-f0-9]{18})"
    ],
    "titleSources": [
      "playerData.title",
      "meta[property=\"og:title\"]",
      "meta[name=\"twitter:title\"]",
      "h1",
      "<title>"
    ],
    "thumbnailSources": [
      "playerData.posterframe_url",
      "meta[property=\"og:image\"]",
      "meta[name=\"twitter:image\"]",
      "img[alt*=\"thumbnail\"]",
      "img[alt*=\"video\"]",
      ".sprout-video img",
      "video[poster]"
    ],
    "durationSources": [
      "playerData.duration"
    ],
    "playerDataExtraction": {
      "method": "Base64-encoded variables (dat, playerInfo, videoInfo) decoded from script content",
      "frameExtraction": "chrome.scripting.executeScript across all frames, MAIN world preferred",
      "fields": [
        "videoUid",
        "title",
        "duration",
        "posterframe_url",
        "hls",
        "signatures",
        "base",
        "s3_user_hash",
        "s3_video_hash",
        "downloads"
      ]
    },
    "directVideoDetection": {
      "selectors": [
        "video[src]",
        "video[data-src]",
        "video source[src]"
      ],
      "urlPatterns": [
        "cloudfront.net",
        "sproutvideo",
        ".mp4"
      ],
      "excludes": [
        "blob: URLs"
      ]
    },
    "embedDataFields": [
      "videoUid",
      "title",
      "duration",
      "posterframe_url",
      "hls",
      "signatures",
      "base",
      "s3_user_hash",
      "s3_video_hash",
      "downloads"
    ]
  },
  "formatObjectStructure": {
    "format_id": "string (hls | source | uhd | sd | hd | etc.)",
    "url": "string",
    "ext": "mp4",
    "protocol": "m3u8_native | https",
    "format_note": "string (HLS (Authenticated) | SOURCE | UHD | etc.)",
    "quality": "number (2=source, 1=hls/uhd, 0=other)",
    "_fragmentQuery": "string (HLS fragment auth query, HLS only)",
    "_keyQuery": "string (HLS key auth query, HLS only)"
  },
  "hlsProcessingSpecs": {
    "urlConstruction": "https://{base}.videos.sproutvideo.com/{s3_user_hash}/{s3_video_hash}/video/index.m3u8?{manifestQuery}",
    "authentication": "Policy-based signatures from playerData.signatures — separate queries for manifests (m), fragments (t), and keys (k)",
    "policyQueryBuilder": "buildPolicyQuery(playerData, type)",
    "formatSorting": "Direct downloads preferred over HLS; sorted by quality descending, then height, then bitrate"
  },
