      ".video-container",
      ".videoWrapper",
      "iframe[src*='videos.sproutvideo.com/embed']",
      "iframe[src*='vids.io']",
      "video"
    ],
    "contextMenu": false,
    "autoSave": true,
    "desktopNotifications": false,
    "videoDetection": "Automatic — embed URL parsing, iframe scanning, base64 player data decoding, direct video URL detection, script content analysis",
    "passwordProtectedVideos": true,
    "multipleVideoSelection": true
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://*.sproutvideo.com/*",
      "https://videos.sproutvideo.com/*",
      "https://images.sproutvideo.com/*",
      "https://*.vids.io/*",
      "https://*.cloudfront.net/*"
    ],
    "contentScripts": [
      {
        "files": [
          "site-config.js",
          "logger.js",
          "download-manager/inline-manager.js"
        ],
        "matches": [
          "<all_urls>"
        ],
        "runAt": "document_start"
      },
      {
        "files": [
          "site-config.js",
          "logger.js",
          "content-enhanced.js"
        ],
        "matches": [
          "https://*.sproutvideo.com/*",
          "https://videos.sproutvideo.com/*",
          "https://*.vids.io/*",
          "https://*/*"
        ],
        "runAt": "document_idle"
      }
    ],
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocuments": [
      {
        "html": "offscreen.html",
        "purpose": "Standard offscreen download"
      },
      {
        "html": "offscreen-faststream.html",
        "js": "offscreen-faststream-legacy.js",
        "purpose": "FastStream download pipeline"
      }
    ],
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
