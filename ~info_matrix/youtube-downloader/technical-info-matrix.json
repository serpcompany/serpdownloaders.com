{
  "extension": "youtube-downloader",
  "coreIdentity": {
    "extensionName": "Video Downloader for YouTube",
    "slug": "youtube-downloader",
    "geckoId": "youtube-downloader@serpapps.com",
    "category": "Video Downloader",
    "targetSites": [
      "youtube.com",
      "youtu.be"
    ],
    "targetSiteMatches": [
      "https://www.youtube.com/*",
      "https://*.youtube.com/*",
      "https://m.youtube.com/*",
      "https://youtu.be/*"
    ],
    "description": "Download YouTube videos with advanced quality selection, queue management, and built-in licensing support."
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/youtube-downloader",
    "lastUpdated": "2026-03-06",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "youtube-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/youtube-downloader",
    "productPage": "https://serp.ly/youtube-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Progressive MP4 (range-fetch via background)",
      "HLS Stitching (m3u8 segment merge to MP4)",
      "SABR/UMP streaming pipeline",
      "Separate A/V mux (offscreen FastStream)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from YouTube InnerTube API streamingData (formats + adaptiveFormats) across multiple clients (WEB, WEB_EMBEDDED, Android, iOS, MWEB, TV_EMBEDDED)",
    "qualitySorting": "By quality label, progressive AV preferred, then best video + best audio separately",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": true,
    "vrSupport": false,
    "bulkDownload": false,
    "maxConcurrentDownloads": 3,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "#player-container",
      "#movie_player",
      ".html5-video-player",
      "ytd-player"
    ],
    "embedDetection": true,
    "embedDetectionMethod": "content-embed-injector.js + detectors/youtube-detector.js for YouTube iframes/links on third-party sites",
    "contextMenu": false,
    "contextMenuId": null,
    "contextMenuTitle": null,
    "contextMenuContexts": null,
    "autoSave": false,
    "downloadFolder": null,
    "desktopNotifications": false,
    "videoDetection": "Multi-source: YouTube InnerTube API extraction (multi-client), watch page ytInitialPlayerResponse, iframe embed scanning, link scanning, script tag scanning, MutationObserver for SPA navigation"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "scripting",
      "offscreen",
      "declarativeNetRequestWithHostAccess"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://www.youtube.com/*",
      "https://*.youtube.com/*",
      "https://youtu.be/*",
      "https://*.googlevideo.com/*",
      "https://*.googleapis.com/*",
      "https://*.ytimg.com/*",
      "https://*.googleusercontent.com/*",
      "https://api.gumroad.com/*",
      "https://ghl-check-license-worker-v2.farleythecoder.workers.dev/*",
      "http://*/*",
      "https://*/*"
    ],
    "contentScripts": [
      {
        "files": [
          "site-config.js",
          "logger.js",
          "content-youtube.js"
        ],
        "matches": [
          "https://www.youtube.com/*",
          "https://*.youtube.com/*",
          "https://m.youtube.com/*",
          "https://youtu.be/*"
        ],
        "allFrames": false,
        "runAt": "document_idle",
        "purpose": "YouTube video detection, in-player download button, download manager"
      },
      {
        "files": [
          "content-embed-injector.js"
        ],
        "matches": [
          "http://*/*",
          "https://*/*"
        ],
        "excludeMatches": [
          "https://www.youtube.com/*",
          "https://*.youtube.com/*",
          "https://m.youtube.com/*",
          "https://youtu.be/*"
        ],
        "allFrames": false,
        "runAt": "document_idle",
        "purpose": "Lightweight YouTube embed/link detector for third-party pages"
      }
    ],
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen-faststream.html",
      "js": "offscreen-faststream-legacy.js",
      "purpose": "HLS/fMP4 segment merging, separate A/V muxing via FastStream pipeline"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "youtubeModule": {
      "path": "modules/youtube/",
      "files": [
        "client.js",
        "signature.js",
        "sabr.js",
        "ump.js",
        "media-assembler.js",
        "utils.js",
        "constants.js"
      ],
      "purpose": "YouTube-specific InnerTube API extraction, cipher/n-param decryption, SABR/UMP streaming"
    },
    "indexedDB": {
      "enabled": true,
      "dbName": "YouTubeDownloaderDB",
      "storeName": "fileStore",
      "purpose": "Segment caching during A/V mux operations"
    },
    "pageInjection": null,
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "YouTube InnerTube API (www.youtube.com/youtubei/v1/player)",
      "YouTube oEmbed API (www.youtube.com/oembed)",
      "Gumroad License API (api.gumroad.com)",
      "License Check Worker (ghl-check-license-worker-v2.farleythecoder.workers.dev)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "youtube-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/youtube-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/youtube-downloader/releases/latest"
    },
    "csp": "script-src 'self'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "youtube.com/watch?v=([a-zA-Z0-9_-]{11})",
      "youtu.be/([a-zA-Z0-9_-]{11})",
      "youtube.com/embed/([a-zA-Z0-9_-]{11})",
      "youtube.com/shorts/([a-zA-Z0-9_-]{11})",
      "m.youtube.com/watch?v=([a-zA-Z0-9_-]{11})",
      "youtube-nocookie.com/embed/([a-zA-Z0-9_-]{11})"
    ],
    "titleSources": [
      "document.title (minus ' - YouTube')",
      "InnerTube videoDetails.title",
      "oEmbed API title"
    ],
    "thumbnailSources": [
      "https://img.youtube.com/vi/{id}/maxresdefault.jpg",
      "https://i.ytimg.com/vi/{id}/maxresdefault.jpg",
      "oEmbed thumbnail",
      "meta[property=\"og:image\"]"
    ],
    "durationSources": [
      "InnerTube videoDetails.lengthSeconds",
      "streamingData"
    ],
    "extraMetadata": {
      "author": "oEmbed author_name, videoDetails.author",
      "width": "oEmbed width, format width",
      "height": "oEmbed height, format height",
      "viewCount": "videoDetails.viewCount"
    },
    "formatSources": [
      "Watch page ytInitialPlayerResponse.streamingData (formats + adaptiveFormats)",
      "InnerTube /youtubei/v1/player API (WEB, WEB_EMBEDDED, Android, iOS, MWEB, TV_EMBEDDED clients)",
      "HLS manifest URL (streamingData.hlsManifestUrl)",
      "SABR streaming URL (streamingData.serverAbrStreamingUrl)"
    ],
    "innerTubeClients": [
      "WEB (clientName: 1)",
      "WEB_EMBEDDED_PLAYER (clientName: 56)",
      "ANDROID (clientName: 3)",
      "IOS (clientName: 5)",
      "MWEB (clientName: 2)",
      "TVHTML5_SIMPLY_EMBEDDED_PLAYER (clientName: 85)"
    ],
    "embedDetection": {
      "iframeSelectors": [
        "iframe[src*=\"youtube.com/embed\"]",
        "iframe[src*=\"youtube-nocookie.com/embed\"]",
        "iframe[src*=\"youtu.be\"]"
      ],
      "linkSelectors": [
        "a[href*=\"youtube.com/watch\"]",
        "a[href*=\"youtu.be/\"]"
      ],
      "scriptTagScanning": true,
      "mutationObserver": true
    }
  },
  "formatObjectStructure": {
    "itag": "number",
    "url": "string",
    "mimeType": "string",
    "container": "mp4 | webm | m4a | 3gp",
    "qualityLabel": "string | null",
    "width": "number | null",
    "height": "number | null",
    "fps": "number | null",
    "bitrate": "number | null",
    "hasVideo": "boolean",
    "hasAudio": "boolean",
    "contentLength": "number | null"
  },
  "hlsProcessingSpecs": {
    "converter": "Custom HLS handler in youtube-handler.js + SimpleHLS2MP4Converter for offscreen",
    "concurrentSegmentDownloads": 6,
    "maxSegmentRetries": 3,
    "nParameterTransformation": true,
    "offscreenMergeTimeoutMs": 300000,
    "streamFormats": [
      "hls_fmp4",
      "hls_ts"
    ],
    "origin": "https://www.youtube.com",
    "referer": "https://www.youtube.com/"
  },
  "sabrProcessingSpecs": {
    "pipeline": "SABRDownloadManager (sabr.js) -> UMPParser (ump.js) -> MediaAssembler (media-assembler.js)",
    "protocol": "application/vnd.yt-ump (Universal Media Protocol)",
    "maxSegments": 200,
    "clientName": "WEB",
    "clientVersion": "2.20250312.04.00",
    "supportsRedirect": true,
    "fallbackToRegularStream": true
  },
