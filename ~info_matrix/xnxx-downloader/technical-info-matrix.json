    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/video-?([0-9a-z]+)/"
    ],
    "titleSources": [
      "meta[property=\"og:title\"]",
      "document.title (XNXX suffix stripped)"
    ],
    "thumbnailSources": [
      "meta[property=\"og:image\"]"
    ],
    "durationSources": [
      "meta[property=\"og:duration\"]",
      "window.video_duration"
    ],
    "extraMetadata": {
      "views": "#nb-views-number",
      "description": "meta[name=\"description\"]"
    },
    "formatSources": [
      "setVideoUrlLow() / setVideoUrlHigh() / setVideoHLS() script functions",
      "Window globals (video_title, video_duration)",
      "videoData / sources / mediaDefinitions script objects",
      "XHR/fetch monitoring for xnxx/media/video URLs"
    ],
    "scriptUrlRegex": "setVideo(?:Url(Low|High)|HLS)\\s*\\(\\s*(['\"])((?:https?:)?\\/\\/.+?)\\2",
    "cdnDetectionPattern": "*.xnxx-cdn.com (host permission)",
    "mediaRequestPatterns": [
      "xnxx",
      "media",
      "video",
      ".m3u8",
      ".mp4"
    ],
    "injectMessageType": "XNXX_PAGE_DATA"
  },
  "formatObjectStructure": {
    "url": "string",
    "quality": "string (low | high) | number",
    "format": "mp4 | hls",
    "height": "number | null",
    "width": "number | null",
    "format_id": "string (xnxx-low | xnxx-high | hls-720p | etc.)",
    "qualityScore": "number",
    "bandwidth": "number | null"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "referer": "https://www.xnxx.com/",
    "userAgent": "navigator.userAgent (browser default)",
    "origin": "https://www.xnxx.com"
  },
