    { "component": "Loom Detector", "files": ["detectors/loom-detector.js", "detectors/loom/"], "purpose": "Loom embed detection and extraction" },
    { "component": "Vimeo Detector", "files": ["detectors/vimeo-detector.js", "detectors/vimeo/"], "purpose": "Vimeo embed/page detection, iframe extraction" },
    { "component": "YouTube Detector", "files": ["detectors/youtube-detector.js"], "purpose": "YouTube embed/page detection" },
    { "component": "Wistia Detector", "files": ["detectors/wistia-detector.js"], "purpose": "Wistia embed detection" },
    { "component": "Sprout Detector", "files": ["detectors/sprout-detector.js"], "purpose": "SproutVideo embed detection" },
    { "component": "Skool Detector", "files": ["detectors/skool-detector-working.js", "detectors/skool/"], "purpose": "Skool native video detection" },
