    "lastUpdated": "2026-03-05",
    "buildDate": null,
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "serp-video-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/serp-video-downloader",
    "productPage": "https://serp.ly/serp-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (offscreen streaming)",
      "HLS Stitching (m3u8 segment to MP4 transmux)",
      "DASH (mpd) conversion",
      "FFmpeg offscreen processing (authenticated HLS)",
      "Platform-specific API extraction (YouTube, Vimeo, Loom, Wistia, Sprout, Skool)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from platform APIs, HTML5 video/source, HLS master playlists, DASH manifests, embedded player configs",
    "qualitySorting": "By height descending, MP4 before HLS, source/original highest priority, video+audio preferred over video-only",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "downloadManagerType": "Modular in-page download manager (download-manager/ — 13 files) with cross-tab sync",
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": false,
    "contextMenu": false,
    "autoSave": true,
    "downloadFolder": "Downloads/",
    "desktopNotifications": true,
    "notificationTitle": "Download Complete",
    "videoDetection": "Modular multi-platform detectors (Loom, Vimeo, YouTube, Wistia, Sprout, Skool) + generic HTML5 video/source/m3u8/mpd/mp4 detection + network candidate tracking",
    "multiVideoCandidates": true,
    "sidePanel": true,
    "maxConcurrentDownloads": 3,
    "autoDownloadBest": true
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "sidePanel",
      "tabs",
      "scripting",
      "offscreen",
      "cookies",
      "webNavigation",
      "declarativeNetRequestWithHostAccess",
      "webRequest"
    ],
    "hostPermissions": [
      "<all_urls>",
      "https://auth.serp.co/*"
    ],
    "contentScripts": [
      {
        "files": ["site-config.js", "logger.js", "content-enhanced-modular.js"],
        "matches": ["<all_urls>"],
        "allFrames": false,
        "runAt": "document_idle"
      },
      {
        "files": ["site-config.js", "logger.js", "content-enhanced-modular.js"],
        "matches": ["https://vimeo.com/*", "https://*.vimeo.com/*", "https://player.vimeo.com/*", "https://*.vhx.tv/*", "https://embed.vhx.tv/*"],
        "allFrames": true,
        "runAt": "document_idle"
      }
    ],
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocuments": [
      {
        "html": "offscreen.html",
        "js": "offscreen-faststream-legacy.js",
        "purpose": "FastStream offscreen document for segment processing"
      },
      {
        "file": "offscreen-ffmpeg.js",
        "purpose": "FFmpeg WASM-based HLS playlist to MP4 conversion"
      }
    ],
    "usesFFmpeg": true,
    "ffmpegPath": "libs/ffmpeg/",
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "youtubeModule": "modules/youtube/",
    "indexedDB": {
      "enabled": true,
      "file": "indexed-db.js"
    },
    "pageInjection": null,
    "dynamicModuleImports": true,
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "YouTube (youtubei.googleapis.com, googlevideo.com)",
      "Vimeo (vimeo.com, player.vimeo.com)",
      "Skool (stream.video.skool.com, fastly.video.skool.com)",
      "Beeg API (beeg.com/api/v6, video.beeg.com/api/v6, store.externulls.com/facts)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "serp-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/serp-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/serp-video-downloader/releases/latest"
    },
    "csp": "script-src 'self'; object-src 'self'; connect-src 'self' https://auth.serp.co;",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';",
    "dnrRules": [
      { "id": 10001, "domain": "googlevideo.com", "purpose": "YouTube media segments" },
      { "id": 10002, "domain": "www.youtube.com", "purpose": "YouTube site API calls" },
      { "id": 10003, "domain": "youtubei.googleapis.com", "purpose": "YouTube internal API" },
      { "id": 10011, "domain": "stream.video.skool.com", "purpose": "Skool HLS manifests" },
      { "id": 10012, "domain": "fastly.video.skool.com", "purpose": "Skool TS/CMF segments" },
      { "id": 10013, "domain": "video.skool.com", "purpose": "Skool generic video host" },
      { "id": 10014, "domain": "b-cdn.net", "purpose": "BunnyCDN VOD (Skool)" }
    ]
  },
  "supportedPlatforms": [
    {
      "platform": "YouTube",
      "detector": "youtube-detector.js",
      "handler": "handlers/youtube/",
      "domains": ["youtube.com", "youtu.be", "googlevideo.com", "youtubei.googleapis.com"]
    },
    {
      "platform": "Vimeo",
      "detector": "vimeo-detector.js",
      "handler": "handlers/vimeo/",
      "domains": ["vimeo.com", "player.vimeo.com", "*.vhx.tv", "embed.vhx.tv"]
    },
    {
      "platform": "Loom",
      "detector": "loom-detector.js",
      "handler": "handlers/loom/",
      "domains": ["loom.com"]
    },
    {
      "platform": "Wistia",
      "detector": "wistia-detector.js",
      "handler": "handlers/wistia/",
      "domains": ["wistia.com", "wistia.net", "fast.wistia.net"]
    },
    {
      "platform": "Sprout",
      "detector": "sprout-detector.js",
      "handler": "background/sprout.js",
      "domains": ["sproutvideo.com", "videos.sproutvideo.com"]
    },
    {
      "platform": "Skool",
      "detector": "skool-detector-working.js",
      "handler": "handlers/skool/",
      "domains": ["skool.com", "stream.video.skool.com", "fastly.video.skool.com"]
    },
    {
      "platform": "Beeg",
      "detector": "Inline in popup.js (content harness)",
      "handler": "Background fetch API",
      "domains": ["beeg.com", "video.beeg.com", "store.externulls.com"]
    },
    {
      "platform": "Generic",
      "detector": "video-detector.js (detectGenericVideoSources)",
      "handler": "Format handlers",
      "domains": ["Any site — HTML5 video, source, m3u8, mpd, mp4 URLs"]
    }
  ],
  "videoDetectionAndExtraction": {
    "genericMediaTypes": ["m3u8 (HLS)", "mpd (DASH)", "mp4", "webm", "mov", "mkv"],
    "urlClassification": "classifyMediaUrl() — matches .m3u8, .mpd, .mp4, .webm, .mov, .mkv, MIME types",
    "domScanning": ["<video> elements (src, currentSrc)", "<source> elements", "Embedded iframes"],
    "platformDetection": "Domain-based routing to platform-specific detectors",
    "networkCandidates": "Background webRequest monitoring + content script Performance API entries",
    "titleSources": ["LD+JSON VideoObject name", "og:title", "twitter:title", "document.title"],
    "thumbnailSources": ["LD+JSON thumbnailUrl", "og:image", "og:image:secure_url", "twitter:image", "Largest <img>"],
    "durationSources": ["LD+JSON duration", "video:duration", "og:video:duration", "ISO 8601 parsing", "HH:MM:SS parsing"],
    "extraMetadata": ["og:description", "video:width", "video:height", "author/publisher from LD+JSON"],
    "candidateMerging": "Platform-specific candidates merged with network candidates; platform labels preferred over Generic"
  },
  "formatObjectStructure": {
    "format_id": "string",
    "ext": "m3u8 | mp4 | mpd | webm | mov | mkv",
    "format_type": "hls | mp4 | dash | playlist_json",
    "quality": "number | null",
    "url": "string",
    "protocol": "m3u8 | https | mpd",
    "filesize": null,
    "tbr": null,
    "width": "number | null",
    "height": "number | null",
    "hasVideo": "boolean",
    "hasAudio": "boolean",
    "platform": "string",
    "source": "string"
  },
  "hlsProcessingSpecs": {
    "converter": "SimpleHLS2MP4Converter + FFmpeg WASM fallback",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "authenticatedHls": true,
    "ffmpegFallback": true
  },
