    { "component": "Vimeo Format Utils", "files": ["background/vimeo-format-utils.js"], "purpose": "Vimeo stream URL extraction" },
    { "component": "Sprout Handler", "files": ["background/sprout.js"], "purpose": "SproutVideo format extraction" },
    { "component": "Chrome Downloads", "files": ["background/chrome-downloads.js"], "purpose": "Chrome downloads API wrapper" },
    { "component": "DNR Rules", "files": ["background/dnr-rules.js"], "purpose": "Declarative net request rules for YouTube and Skool" },
    { "component": "Offscreen Manager", "files": ["background/offscreen-manager.js"], "purpose": "Offscreen document lifecycle management" },
    { "component": "Progress Reporter", "files": ["background/progress-reporter.js"], "purpose": "Download progress broadcasting" },
    { "component": "Side Panel", "files": ["background/side-panel.js"], "purpose": "Side panel registration" },
    { "component": "Thumbnail Proxy", "files": ["background/thumbnail-proxy.js"], "purpose": "Cross-origin thumbnail proxying" },
    { "component": "Loom Handler", "files": ["handlers/loom-handler.js", "handlers/loom/"], "purpose": "Loom download handling" },
    { "component": "Vimeo Handler", "files": ["handlers/vimeo-handler.js", "handlers/vimeo/"], "purpose": "Vimeo download handling" },
    { "component": "YouTube Handler", "files": ["handlers/youtube-handler.js", "handlers/youtube/"], "purpose": "YouTube download handling" },
    { "component": "Wistia Handler", "files": ["handlers/wistia-handler.js", "handlers/wistia/"], "purpose": "Wistia download handling" },
    { "component": "Skool Handler", "files": ["handlers/skool-handler.js", "handlers/skool/"], "purpose": "Skool download handling" },
    { "component": "Popup", "files": ["popup.html", "popup.js"], "purpose": "UI, multi-candidate selector, quality selector, auth flow, auto-download best" },
    { "component": "Offscreen (FastStream)", "files": ["offscreen.html", "offscreen-faststream-legacy.js"], "purpose": "FastStream offscreen document for segment processing" },
    { "component": "Offscreen (FFmpeg)", "files": ["offscreen-ffmpeg.js"], "purpose": "FFmpeg WASM-based HLS playlist to MP4 conversion" },
