    { "component": "Network Candidate Tracker", "files": ["background/network-candidates.js"], "purpose": "Tracks media URLs from network requests" },
    { "component": "Download Queue", "files": ["background/download-queue.js"], "purpose": "Queued download management (max 3 concurrent)" },
    { "component": "Download Handlers", "files": ["background/download-handlers.js"], "purpose": "Download action handlers" },
    { "component": "Download State", "files": ["background/download-state.js", "background/download-state-utils.js"], "purpose": "Download state store with pruning" },
    { "component": "Format Handlers", "files": ["background/format-handlers.js"], "purpose": "Format-specific download handling" },
    { "component": "Handler Factory", "files": ["background/handler-factory.js"], "purpose": "Platform-specific handler creation" },
    { "component": "HLS Playlist", "files": ["background/hls-playlist.js"], "purpose": "Authenticated HLS playlist building and variant parsing" },
