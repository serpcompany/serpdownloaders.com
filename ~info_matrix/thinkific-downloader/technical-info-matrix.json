    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "[data-wistia-id]",
      "[data-wistia-hashed-id]",
      "video",
      "nearest video container"
    ],
    "contextMenu": true,
    "contextMenuId": "download-thinkific-video",
    "contextMenuTitle": "Download Thinkific Video",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "thinkific/",
    "desktopNotifications": false,
    "notificationTitle": null,
    "videoDetection": "Multi-source: Wistia embed data attributes ([data-wistia-id], [data-wistia-hashed-id]), _wq global, wistia_async classes, Wistia JSON API, HTML5 video, LD+JSON VideoObject, og/twitter meta tags"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen",
      "webRequest"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://www.thinkific.com/*",
      "https://thinkific.com/*",
      "https://*.thinkific.com/*",
      "https://cdn.thinkific.com/*",
      "https://*.wistia.com/*",
