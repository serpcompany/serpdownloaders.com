    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (offscreen streaming)",
      "HLS Stitching (m3u8 segment transmux via offscreen)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from Wistia embed JSON API assets (master HLS, delivery HLS, MP4 originals)",
