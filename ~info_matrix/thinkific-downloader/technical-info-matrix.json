      "https://fast.wistia.com/*",
      "https://fast.wistia.net/*",
      "https://embedwistia-a.akamaihd.net/*",
      "https://*.akamaihd.net/*",
      "https://*.cloudfront.net/*"
    ],
    "contentScripts": {
      "files": [
        "content-scripts/content.js"
      ],
      "matches": [
        "https://*.thinkific.com/*",
        "https://thinkific.com/*",
        "https://www.thinkific.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background.js",
      "type": "non-module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "MP4 streaming download + HLS segment transmuxing"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": false,
    "hlsLibrary": "Bundled in offscreen.js",
    "hlsToMp4Transmuxer": "Bundled in offscreen.js (HLS segment transmux to MP4)",
    "dashToMp4": null,
    "mp4Box": null,
    "reencoder": null,
    "networkUtils": "Bundled in offscreen.js",
    "indexedDB": {
      "enabled": true
    },
    "pageInjection": {
      "file": null,
      "purpose": "Detection logic bundled in content-scripts/content.js, no standalone inject.js",
      "messageType": null
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "Wistia Embed API (fast.wistia.com/embed/medias/{id}.json, fast.wistia.net/embed/medias/{id}.json)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "thinkific-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/thinkific-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/thinkific-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": [],
    "webRequestApi": {
      "enabled": true,
      "listeners": [
        "onHeadersReceived"
      ],
      "purpose": "CDN header interception for Wistia/Akamai/CloudFront"
    }
  },
  "videoDetectionAndExtraction": {
    "videoIdDetection": [
      "[data-wistia-hashed-id] attribute",
      "[data-wistia-id] attribute",
      "_wq global (Wistia queue)",
      "wistia_async class names"
    ],
    "wistiaApiUrls": [
      "https://fast.wistia.com/embed/medias/{id}.json",
      "https://fast.wistia.net/embed/medias/{id}.json"
    ],
    "titleSources": [
      "LD+JSON VideoObject.name",
      "meta[property=\"og:title\"]",
      "meta[name=\"twitter:title\"]",
      "document.title"
    ],
    "thumbnailSources": [
      "LD+JSON VideoObject.thumbnailUrl",
      "og:image",
      "twitter:image",
      "og:image:secure_url"
    ],
    "durationSources": [
      "LD+JSON VideoObject.duration",
      "meta[property=\"video:duration\"]",
      "ISO 8601 parsing"
    ],
    "extraMetadata": {
      "description": "og:description, twitter:description, LD+JSON",
      "dimensions": "og:video:width, og:video:height, LD+JSON",
      "author": "LD+JSON author.name, publisher.name, meta[name=\"author\"]"
    },
    "formatSources": [
      "Wistia Embed JSON API assets array (master HLS, delivery HLS, MP4)",
      "HTML5 <video> element",
      "Content script Wistia ID extraction"
    ],
    "cdnDetectionPatterns": [
      "/wistia\\.com/i",
      "/wistia\\.net/i",
      "/akamaihd\\.net/i",
      "/cloudfront\\.net/i"
    ],
    "mediaRequestPatterns": [
      "fast.wistia.com/embed/medias/*",
      "fast.wistia.net/embed/medias/*",
      ".m3u8",
      ".mp4"
    ]
  },
  "formatObjectStructure": {
    "format_id": "string (e.g., 'master (HLS)', 'delivery (HLS)')",
    "ext": "m3u8 | mp4",
    "format_type": "hls | mp4",
    "quality": "number | null",
    "url": "string",
    "protocol": "m3u8 | https",
    "filesize": null,
    "tbr": null,
    "width": null,
    "height": "number | null"
  },
  "hlsProcessingSpecs": {
    "converter": "Bundled HLS transmuxer (offscreen.js)",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "backoffStrategy": "linear",
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "referer": "Thinkific school domain (dynamic)",
    "origin": "Thinkific school domain (dynamic)"
  },
  "architecture": [
    {
      "component": "Content Script",
      "files": [
        "content-scripts/content.js"
      ],
      "purpose": "Video detection (Wistia embeds, data attributes, _wq global), metadata scraping, in-page download button, download manager panel"
    },
    {
      "component": "Service Worker",
      "files": [
        "background.js"
      ],
      "purpose": "Download orchestration, auth gating, offscreen management, context menu, Wistia API fetching"
    },
    {
      "component": "Service Worker (Enhanced)",
      "files": [
        "background-enhanced.js"
      ],
      "purpose": "Enhanced background with Wistia JSON API calls, format extraction, HLS/MP4 routing"
    },
    {
      "component": "Popup",
      "files": [
        "popup.html",
        "popup.js"
      ],
      "purpose": "UI, quality selector, auth flow"
    },
    {
      "component": "Offscreen",
      "files": [
        "offscreen.html",
        "offscreen.js"
      ],
      "purpose": "MP4 streaming + HLS transmux"
    },
    {
      "component": "Auth",
      "files": [
        "auth.js",
        "auth/auth-config.js",
        "auth/auth-api.js",
        "auth/auth-storage.js",
        "auth/auth-token.js",
        "auth/auth-telemetry.js"
      ],
      "purpose": "OTP login, entitlements, trial"
    },
    {
      "component": "Auth UI",
      "files": [
        "auth-ui.js"
      ],
      "purpose": "Popup OTP auth UI wiring and normalization"
    },
    {
      "component": "Logger",
      "files": [
        "logger.js"
      ],
      "purpose": "Structured logging, bg mirroring"
    },
    {
      "component": "Site Config",
      "files": [
        "site-config.js"
      ],
      "purpose": "Brand colors, endpoints, flags"
    },
    {
      "component": "Update Notifier",
      "files": [
        "update-notifier.js"
      ],
      "purpose": "GitHub release checks"
    },
    {
      "component": "Trial Banner",
      "files": [
        "trial-banner.js"
      ],
      "purpose": "Trial remaining badge"
    },
    {
      "component": "Bootstrap",
      "files": [
        "bootstrap.js"
      ],
      "purpose": "WXT bootstrap entrypoint (no-op)"
    }
