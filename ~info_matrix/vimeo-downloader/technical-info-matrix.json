{
  "extension": "vimeo-downloader",
  "coreIdentity": {
    "extensionName": "Video Downloader for Vimeo",
    "slug": "vimeo-downloader",
    "geckoId": "vimeo-downloader@serpapps.com",
    "category": "Video Downloader",
    "targetSites": [
      "vimeo.com",
      "player.vimeo.com",
      "*.vhx.tv",
      "embed.vhx.tv"
    ],
    "targetSiteMatches": [
      "https://vimeo.com/*",
      "https://*.vimeo.com/*",
      "https://player.vimeo.com/*",
      "https://*.vhx.tv/*",
      "https://embed.vhx.tv/*",
      "<all_urls>"
    ],
    "description": "Download Vimeo videos directly to your computer"
  },
  "versionAndStatus": {
    "manifestVersion": "4.0.1",
    "packageVersion": "2.1.0",
    "manifestSpec": "MV3",
    "branchName": "legacy/vimeo-downloader",
    "lastUpdated": "2026-03-05",
    "buildDate": "2026-02-12 (BUILD TAG: adaptive-quality-fix-2026-02-12-c)",
    "developmentStatus": "Active"
  },
  "storeAndDistribution": {
    "chromeWebStoreUrl": null,
    "firefoxAddonsUrl": null,
    "edgeAddonsUrl": null,
    "safariAvailable": false,
    "chromeStoreStatus": null,
    "storeSanitizedBuild": true,
    "storeSanitizedFile": "vimeo-downloader-chrome-store-sanitized.zip",
    "githubReleasesRepo": "serpapps/vimeo-video-downloader",
    "productPage": "https://serp.ly/vimeo-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "HLS Stitching (m3u8 segment to MP4 transmux via offscreen FastStream)",
      "Progressive MP4 direct download",
      "DASH URL extraction"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from playerConfig.request.files (HLS, progressive, DASH CDNs), Vimeo config API, JSON-LD, DOM heuristics",
    "qualitySorting": "By quality, progressive formats mapped with width/height/fps/profile",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      ".player",
      ".player.js-player",
      ".player-container",
      ".player_container",
      ".vh-player-area",
      "[class*='js-player_container_']",
      ".js-player",
      ".vp-video-wrapper",
      ".vp-player-ui-container",
      ".vp-video",
      "video"
    ],
    "contextMenu": false,
    "contextMenuId": null,
    "contextMenuTitle": null,
    "contextMenuContexts": null,
    "autoSave": true,
    "downloadFolder": null,
    "desktopNotifications": false,
    "notificationTitle": null,
    "videoDetection": "Multi-source: playerConfig, vimeo.config, inline script parsing, bootstrap_data, JSON-LD, DOM heuristics, Performance API resource observer, iframe embed probing",
    "passwordProtectedVideos": true,
    "multipleVideoSelection": true,
    "embedDetection": true,
    "thirdPartyEmbedSupport": true
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "storage",
      "tabs",
      "scripting",
      "webNavigation",
      "offscreen",
      "cookies",
      "declarativeNetRequest"
    ],
    "hostPermissions": [
      "https://auth.serp.co/*",
      "https://vimeo.com/*",
      "https://*.vimeo.com/*",
      "https://*.vimeocdn.com/*",
      "https://*.cloudfront.net/*",
      "https://unpkg.com/*",
      "https://api.gumroad.com/*",
      "https://player.vimeo.com/*",
      "<all_urls>"
    ],
    "contentScripts": [
      {
        "files": [
          "site-config.js",
          "logger.js",
          "download-manager/inline-manager.js"
        ],
        "matches": [
          "<all_urls>"
        ],
        "allFrames": false,
        "runAt": "document_idle"
      },
      {
        "files": [
          "site-config.js",
          "logger.js",
          "content-enhanced.js"
        ],
        "matches": [
          "https://vimeo.com/*",
          "https://*.vimeo.com/*",
          "https://player.vimeo.com/*",
          "https://*.vhx.tv/*",
          "https://embed.vhx.tv/*"
        ],
        "allFrames": true,
        "runAt": "document_idle"
      }
    ],
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen-faststream.html",
      "js": "offscreen-faststream-legacy.js",
      "purpose": "HLS segment transmuxing via FastStream wrapper"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/hls.mjs",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter via FastStreamHLS2MP4Wrapper)",
    "dashToMp4": null,
    "mp4Box": null,
    "reencoder": null,
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": true,
      "dbName": "VimeoDownloaderDB",
      "storeName": "fileStore",
      "dbVersion": 1
    },
    "pageInjection": {
      "file": null,
      "purpose": "content-enhanced.js runs in all_frames:true, monitors Performance API resources, probes iframes",
      "messageType": null
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "Gumroad License API (api.gumroad.com)",
      "Vimeo Player Config (player.vimeo.com/video/*/config)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "vimeo-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/vimeo-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/vimeo-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline'; child-src 'self';",
    "dnrRules": [
      {
        "id": 21020,
        "action": "Set Origin/Referer headers to player.vimeo.com",
        "condition": "Requests to cloudfront.net (xmlhttprequest, media, other)"
      },
      {
        "id": 21021,
        "action": "Set CORS allow-origin/expose-headers/timing-allow-origin to *",
        "condition": "Responses from vimeocdn.com (xmlhttprequest, media, other)"
      },
      {
        "id": 21022,
        "action": "Set CORS allow-origin/expose-headers/timing-allow-origin to *",
        "condition": "Responses from cloudfront.net (xmlhttprequest, media, other)"
      }
    ]
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/video/(\\d+)",
      "vimeo.com/(\\d+)"
    ],
    "titleSources": [
      "playerConfig.video.title",
      "vimeo.config.video.title",
      "JSON-LD name",
      "document.title",
      "meta[property=\"og:title\"]"
    ],
    "thumbnailSources": [
      "playerConfig.video.thumbnail_url",
      "playerConfig.request.thumb_preview.url",
      "JSON-LD thumbnailUrl",
      "meta[property=\"og:image\"]"
    ],
    "durationSources": [
      "playerConfig.video.duration",
      "ISO 8601 PT duration parsing",
      "JSON-LD duration"
    ],
    "extraMetadata": {
      "owner": "playerConfig.video.owner.name",
      "description": "playerConfig / JSON-LD / og:description",
      "embedUrl": "JSON-LD / playerConfig",
      "thumbPreview": "playerConfig.request.thumb_preview (sprite data)"
    },
    "formatSources": [
      "playerConfig.request.files (HLS CDNs, progressive array, DASH CDNs)",
      "window.vimeo.config",
      "Inline script parsing (window.playerConfig = {...})",
      "Bootstrap data / embedded config objects",
      "Vimeo Player Config API (/video/*/config)",
      "JSON-LD",
      "DOM heuristics"
    ],
    "hlsCdnSelection": "chooseFromCdns() -- prefers default_cdn, falls back to first CDN with .url or .avc_url",
    "cdnDetectionPattern": null,
    "mediaRequestPatterns": [
      ".m3u8",
      "master.json",
      "player.vimeo.com/video/*/config"
    ],
    "injectMessageType": null,
    "passwordProtected": true,
    "multipleVideos": true,
    "embedDetection": {
      "iframePatterns": [
        "iframe[src*='player.vimeo.com']",
        "iframe[data-large*='player.vimeo.com']",
        "iframe[src*='vimeo.com/event/']",
        "iframe[src*='vimeo.com/showcase/']",
        "iframe[src*='embed.vhx.tv']"
      ],
      "postMessageMethods": [
        "getVideoId",
        "setVolume",
        "play",
        "setCurrentTime"
      ]
    }
  },
  "formatObjectStructure": {
    "url": "string",
    "quality": "string | null",
    "width": "number | null",
    "height": "number | null",
    "mime": "string | null",
    "fps": "number | null",
    "profile": "string | null"
  },
  "hlsProcessingSpecs": {
    "converter": "FastStreamHLS2MP4Wrapper (wraps HLS2MP4 from modules/hls2mp4/hls2mp4.mjs)",
    "batchSize": "Math.min(10, totalSegments)",
    "fallbackSwFetchRetries": 4,
    "fallbackBackoffBaseMs": 800,
    "originHeader": "https://player.vimeo.com",
    "refererHeader": "https://player.vimeo.com/",
    "formatPreference": "TS (FORCE_TS_FORMAT: true by default)"
  },
  "architecture": [
    {
      "component": "Content Script",
      "files": [
        "content-enhanced.js"
      ],
      "purpose": "Video detection, format extraction (playerConfig, vimeo.config, scripts, JSON-LD, DOM), embed iframe probing, Performance API monitoring, overlay download button"
    },
    {
      "component": "Download Manager (inline)",
      "files": [
        "download-manager/inline-manager.js"
      ],
      "purpose": "In-page download progress panel with cross-tab sync"
    },
    {
      "component": "Download Manager (modular)",
      "files": [
        "download-manager/download-manager.js"
      ],
      "purpose": "Full modular download manager with state, UI, auto-remove"
    },
    {
      "component": "Download Manager Config",
      "files": [
        "download-manager/download-manager-config.js"
      ],
      "purpose": "Configuration and presets for download manager"
    },
    {
      "component": "Download Manager State",
      "files": [
        "download-manager/download-manager-state.js"
      ],
      "purpose": "State management for downloads"
    },
    {
      "component": "Download Manager UI",
      "files": [
        "download-manager/download-manager-ui.js"
      ],
      "purpose": "UI rendering for download panel"
    },
    {
      "component": "Download Task Registry",
      "files": [
        "download-manager/download-task-registry.js"
      ],
      "purpose": "Queue management, active/queued/cancelled tracking, chrome download bookkeeping"
    },
    {
      "component": "Integration Helper",
      "files": [
        "download-manager/integration-helper.js"
      ],
      "purpose": "Integration utilities"
    },
    {
      "component": "Service Worker",
      "files": [
        "background-enhanced.js"
      ],
      "purpose": "Download orchestration, auth, offscreen, Vimeo API/config extraction, DNR rules, queue processing"
    },
    {
      "component": "Popup",
      "files": [
        "popup.html",
        "popup-enhanced.js"
      ],
      "purpose": "UI, quality selector, video info, password input, multi-video selection, embed detection"
    },
    {
      "component": "Offscreen",
      "files": [
        "offscreen-faststream.html",
        "offscreen-faststream-legacy.js"
      ],
      "purpose": "HLS segment transmuxing via FastStream"
    },
    {
      "component": "Auth",
      "files": [
        "auth.js",
        "auth/auth-api.js",
        "auth/auth-config.js",
        "auth/auth-storage.js",
        "auth/auth-telemetry.js",
        "auth/auth-token.js"
      ],
      "purpose": "OTP login, entitlements, trial management"
    },
    {
      "component": "Auth UI",
      "files": [
        "auth-ui.js"
      ],
      "purpose": "OTP auth UI wiring for popup"
    },
    {
      "component": "Logger",
      "files": [
        "logger.js"
      ],
      "purpose": "Structured logging with level gating, bg mirroring"
    },
    {
      "component": "Site Config",
      "files": [
        "site-config.js"
      ],
      "purpose": "Brand colors, endpoints, feature flags, Gumroad/GH license IDs"
    },
    {
      "component": "Trial Banner",
      "files": [
        "trial-banner.js"
      ],
      "purpose": "Trial remaining badge in popup"
    },
    {
      "component": "IndexedDB",
      "files": [
        "indexed-db.js"
      ],
      "purpose": "Key-value store for segment caching"
    }
  ],
