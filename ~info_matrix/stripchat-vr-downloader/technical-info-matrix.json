  "featuresAndCapabilities": {
    "downloadMethod": [
      "HLS Live Capture (real-time segment recording)",
      "HLS Stitching (m3u8 segment to MP4 transmux)",
      "Direct MP4 (offscreen streaming)"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from HLS master manifests, Stripchat API metadata, VR camera settings",
    "qualitySorting": "By height descending",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": true,
    "liveStreamMethod": "Real-time HLS live capture with start/stop controls",
    "vrSupport": true,
    "vrFeatures": "VR camera settings (stereoPacking, frameFormat, horizontalAngle), VR filename suffixes, VR badge in UI",
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "[data-testid=\"video-player\"]",
      ".player__video-wrapper",
      ".video-player__wrapper",
      ".media-player",
      "#player-root",
      ".video-player",
      "nearest video container (.video-container, .player-container, .video-wrapper)"
    ],
    "contextMenu": true,
    "contextMenuId": "download-stripchat-vr-video",
    "contextMenuTitle": "Download StripchatVR Stream",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": null,
    "desktopNotifications": false,
    "videoDetection": "Multi-source: Stripchat API, __PRELOADED_STATE__, Performance API, script regex, inject.js state monitor"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting",
      "offscreen"
    ],
    "hostPermissions": [
