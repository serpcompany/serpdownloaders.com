        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://vr.stripchat.com/*",
        "https://stripchat.com/*",
        "https://www.stripchat.com/*",
        "https://*.stripchat.com/*"
      ],
      "allFrames": false,
