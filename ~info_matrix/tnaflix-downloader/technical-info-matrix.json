    "githubReleasesRepo": "serpapps/tnaflix-video-downloader",
    "productPage": "https://serp.ly/tnaflix-video-downloader",
    "helpCenter": "https://help.serp.co/en/"
  },
  "featuresAndCapabilities": {
    "downloadMethod": [
      "Direct MP4 (content-script blob streaming)",
      "HLS Stitching (offscreen segment concatenation)",
      "Chrome downloads API fallback"
    ],
    "qualitySelection": true,
    "qualityMode": "Parsed from config XML, EMPFlix API, HTML5 video/source, script regex, data attributes",
    "qualitySorting": "By height descending, MP4 before HLS",
    "authRequired": "OTP (email verification via auth.serp.co)",
    "trialDownloads": 3,
    "hasDownloadManager": true,
    "liveStreamSupport": false,
    "vrSupport": false,
    "bulkDownload": false,
    "inPagePlayerButton": true,
    "playerButtonTargets": [
      "#video-player-container",
      "#player",
      ".player",
      "#videoBox",
      ".video-player",
      ".video-container",
      "nearest positioned ancestor (min 300x200)"
    ],
    "contextMenu": true,
    "contextMenuId": "download-tnaflix-video",
    "contextMenuTitle": "Download TNAFlix Video",
    "contextMenuContexts": [
      "page",
      "video"
    ],
    "autoSave": true,
    "downloadFolder": "TNAFlix/",
    "desktopNotifications": true,
    "notificationTitle": "Download Complete",
    "videoDetection": "Multi-source: config XML (flashvars/hidden inputs), EMPFlix API, HTML5 video/source, script regex, data attributes, JSON-LD, inject.js XHR/fetch monitor"
  },
  "technicalDetails": {
    "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "notifications",
      "contextMenus",
      "tabs",
      "scripting"
    ],
    "hostPermissions": [
      "https://api.github.com/*",
      "https://auth.serp.co/*",
      "https://tnaflix.com/*",
      "https://www.tnaflix.com/*",
      "https://store.externulls.com/*"
    ],
    "contentScripts": {
      "files": [
        "site-config.js",
        "logger.js",
        "download-manager.js",
        "content.js",
        "player-button.js"
      ],
      "matches": [
        "https://tnaflix.com/*",
        "https://www.tnaflix.com/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "purpose": "HLS segment downloading and concatenation"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": true,
    "hlsLibrary": "modules/hls/",
    "hlsToMp4Transmuxer": "modules/hls2mp4/simple-converter.mjs (SimpleHLS2MP4Converter)",
    "dashToMp4": "modules/dash2mp4/",
    "mp4Box": "modules/mp4box.mjs (319 KB)",
    "reencoder": "modules/reencoder/",
    "networkUtils": "modules/network/",
    "indexedDB": {
      "enabled": false
    },
    "pageInjection": {
      "file": "inject.js",
      "purpose": "Page-context XHR/fetch monitor, global variable probing, extracts media URLs",
      "messageType": "TNAFLIX_PAGE_DATA"
    },
    "externalAPIs": [
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)",
      "TNAFlix AJAX API (www.tnaflix.com/ajax/video-player/)",
      "ExterNulls CDN (store.externulls.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "tnaflix-video-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/tnaflix-video-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/tnaflix-video-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/[^/]+/([^/]+)/video(\\d+)",
      "(?:tnaflix\\.com(?:\\.br)?/|embed\\.tnaflix\\.com/\\?.*?\\bid=)(\\d+)"
    ],
    "titleSources": [
      "div.watchVideoTitle",
      "meta[property=\"og:title\"]",
      "meta[name=\"title\"]",
      "<title>",
      "JSON-LD VideoObject.name"
    ],
    "thumbnailSources": [
      "imageurl=",
      "poster:",
      "og:image",
      "JSON-LD VideoObject.thumbnailUrl"
    ],
    "durationSources": [
      "duration: in scripts",
      "meta[property=\"video:duration\"]",
      "JSON-LD VideoObject.duration"
    ],
    "extraMetadata": {
      "description": "og:description, JSON-LD VideoObject.description",
      "uploader": "div.submitByLink",
      "displayId": "Extracted from URL path"
    },
    "formatSources": [
      "Config XML (flashvars.config, hidden input vkey/nkey)",
      "EMPFlix-style AJAX API (/ajax/video-player/{id})",
      "HTML5 <video>/<source>",
      "Script regex for mp4/m3u8 URLs",
      "Data attributes (data-video-url, data-src, data-file)",
      "JSON objects in scripts"
    ],
    "configXmlUrlPatterns": [
      "flashvars.config = escape(\"...\")",
      "<input name=\"config\" value=\"...\">",
      "https://cdn-fck.tnaflix.com/tnaflix/{vkey}.fid"
    ],
    "empflixApiUrl": "https://www.tnaflix.com/ajax/video-player/{videoId}",
    "scriptUrlRegex": "/https?:\\/\\/[^\"'\\s]+\\.(?:mp4|m3u8)[^\"'\\s]*/gi",
    "cdnDetectionPattern": null,
    "mediaRequestPatterns": [
      "tnaflix",
      "externulls",
      "video",
      ".m3u8",
      ".mp4"
    ],
    "injectMessageType": "TNAFLIX_PAGE_DATA"
  },
  "formatObjectStructure": {
    "format_id": "string",
    "ext": "mp4 | m3u8 | flv",
    "format_type": "mp4 | hls | flv",
    "quality": "string | null",
    "url": "string",
    "protocol": "http | m3u8 | m3u8_native",
    "filesize": null,
    "tbr": null,
    "width": null,
    "height": "number | null"
  },
  "hlsProcessingSpecs": {
    "converter": "Custom offscreen segment concatenation",
    "maxSegmentRetries": 3,
    "backoffBaseMs": 500,
    "stallTimeoutMs": 30000,
    "absoluteTimeoutMs": null,
    "referer": "https://www.tnaflix.com/",
    "userAgent": "navigator.userAgent (browser default)",
    "origin": "https://www.tnaflix.com"
  },
