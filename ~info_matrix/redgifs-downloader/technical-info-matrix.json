      "tokenEndpoint": "https://api.redgifs.com/v2/auth/temporary",
      "tokenMethods": [
        "GET",
        "POST"
      ],
      "tokenCacheDurationMinutes": 55,
      "gifDataEndpoint": "https://api.redgifs.com/v2/gifs/{id}",
      "authHeader": "Authorization: Bearer {token}",
      "customHeader": "x-customheader: {referer}",
      "metaCacheTtlMinutes": 20,
      "metaCacheMaxEntries": 800
    },
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "redgifs-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/redgifs-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/redgifs-downloader/releases/latest"
    },
    "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandboxCsp": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';",
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/(?:watch|ifr)/([^/?#]+) from URL pathname",
      "data-feed-item-id attribute",
      "media URL filename extraction (strip extension and suffixes)"
    ],
    "idValidation": "isLikelyRedgifsId(): 8-48 lowercase alphanumeric, not all digits, not starting with feedmodule",
    "titleSources": [
      "collectTextFromCard (feed card text)",
      "meta[property=\"og:title\"]",
      "document.title (filtered for generic titles)"
    ],
    "thumbnailSources": [
      "og:image",
      "twitter:image",
      "<video> poster attribute"
    ],
    "durationSources": [
      "meta[property=\"og:video:duration\"]",
      "ISO 8601 PT format parsing"
    ],
    "extraMetadata": {
      "tags": "meta[name=\"keywords\"]",
      "jsonLd": "script[type=\"application/ld+json\"]"
    },
    "formatSources": [
      "RedGifs API v2 /v2/gifs/{id} (primary)",
      "HTML5 <video> element source",
      "og:video meta tags",
      "inject.js intercepted API responses"
    ],
    "feedScanning": {
      "selectors": [
        ".GifPreview_isActive",
        ".tileItem",
        ".GifPreview",
        "[data-feed-item-id]"
      ],
      "description": "Scans feed pages for multiple video items"
    },
    "injectMessageType": "REDGIFS_PAGE_DATA",
    "injectCaptureFilter": "api.redgifs.com/v2/gifs/{id} (no sub-paths)"
  },
  "formatObjectStructure": {
    "format_id": "string",
    "ext": "m3u8 | mp4",
    "format_type": "hls | mp4",
    "quality": "number | null",
    "url": "string",
