  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "viewkey=([a-zA-Z0-9]+)"
    ],
    "titleSources": [
      "h1.title",
      "[data-video-title]",
      "meta[property=\"og:title\"]"
