      ],
      "matches": [
        "https://dailymotion.com/*",
        "https://www.dailymotion.com/*",
        "https://*.dailymotion.com/*",
        "https://*.dmcdn.net/*"
      ],
      "allFrames": false,
      "runAt": "document_idle"
    },
    "backgroundServiceWorker": {
      "file": "background-enhanced.js",
      "type": "module"
    },
    "offscreenDocument": {
      "html": "offscreen.html",
      "js": "offscreen.js",
      "sizeBytes": 352152,
      "purpose": "HLS segment stitching to MP4 blob + direct MP4 streaming download"
    },
    "usesFFmpeg": false,
    "usesMediaBunny": false,
    "hlsLibrary": "Built-in — master playlist parsing + media segment parsing in background-enhanced.js",
    "hlsToMp4Transmuxer": "Offscreen-based (PROCESS_HLS_SEGMENTS / HLS_PROCESSING_COMPLETE messages)",
    "dashToMp4": null,
    "mp4Box": "Bundled in offscreen.js (352 KB total)",
    "reencoder": null,
    "networkUtils": null,
    "indexedDB": {
      "enabled": false
    },
    "pageInjection": null,
    "externalAPIs": [
      "Dailymotion Player Metadata API (/player/metadata/video/{id})",
      "SERP Auth (auth.serp.co)",
      "GitHub Releases API (api.github.com)"
    ],
    "updateCheck": {
      "enabled": true,
      "provider": "github-releases",
      "repoOwner": "serpapps",
      "repoName": "dailymotion-downloader",
      "intervalHours": 6,
      "timeoutSeconds": 8,
      "releaseApiUrl": "https://api.github.com/repos/serpapps/dailymotion-downloader/releases/latest",
      "releasePageUrl": "https://github.com/serpapps/dailymotion-downloader/releases/latest"
    },
    "csp": "script-src 'self'; object-src 'self';",
    "sandboxCsp": null,
    "dnrRules": []
  },
  "videoDetectionAndExtraction": {
    "videoIdPatterns": [
      "/video/([^/?#]+)"
    ],
    "videoUrlPattern": "https://(?:www\\.)?dailymotion\\.com/video/",
    "titleSources": [
      "meta[property=\"og:title\"]",
      "meta[name=\"twitter:title\"]",
      "h1 element",
      "document.title (cleaned of ' - video Dailymotion' suffix)"
    ],
    "thumbnailSources": [
      "og:image",
      "og:image:secure_url",
      "twitter:image",
      "twitter:image (property)",
      "https://www.dailymotion.com/thumbnail/video/{id} (fallback)"
    ],
    "durationSources": [
      "meta[property=\"video:duration\"]",
      "meta[name=\"video:duration\"]",
      "meta[itemprop=\"duration\"]",
      "JSON-LD VideoObject with ISO 8601 duration (PT#H#M#S)"
    ],
    "descriptionSources": [
      "og:description",
      "meta[name=\"description\"]",
      "meta[name=\"twitter:description\"]"
    ],
    "metadataApi": "https://www.dailymotion.com/player/metadata/video/{videoId}",
    "formatSources": [
      "Metadata API qualities object (keyed by resolution)",
      "Metadata API manifest_url / streaming_url fallback",
      "HLS master playlist variant expansion"
    ],
    "hlsContentTypes": [
      "application/vnd.apple.mpegurl",
      "application/x-mpegURL"
    ],
    "injectMessageType": null
  },
  "formatObjectStructure": {
    "format_id": "string (e.g. '720p', 'auto-0')",
    "qualityLabel": "string (e.g. '720p', 'Auto')",
    "ext": "m3u8 | mp4",
    "format_type": "hls | http",
    "url": "string",
    "height": "number | undefined",
    "bandwidth": "number | undefined",
    "source": "metadata | master-playlist"
  },
  "hlsProcessingSpecs": {
    "playlistParser": "Built-in parseMasterVariants() + parseMediaSegments() in background-enhanced.js",
    "masterPlaylistParsing": "#EXT-X-STREAM-INF with RESOLUTION and BANDWIDTH extraction",
    "mediaPlaylistParsing": "#EXTINF durations, #EXT-X-MAP init segments, segment URLs",
    "maxNestingDepth": 3,
    "variantSelection": "Sorted by height descending, highest quality selected",
    "formatDeduplication": "By URL — first occurrence kept",
    "formatSorting": "By height descending, HLS before HTTP at same height",
    "referer": "https://www.dailymotion.com/",
    "credentials": "include",
    "cache": "no-store"
  },
